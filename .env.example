# Database
# From your laptop against docker compose Postgres, use localhost (not the service name "postgres").
# If you see P1001 / "Can't reach database server", start Postgres: npm run docker:up
DATABASE_URL="postgresql://user:password@localhost:5432/workforce_db?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Encryption (CRITICAL for production)
# Generate a strong 32+ character key: openssl rand -base64 32
ENCRYPTION_MASTER_KEY="CHANGE-THIS-IN-PRODUCTION-USE-STRONG-32-CHAR-KEY"
ENCRYPTION_SALT="payroll-platform-salt-v1"

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Payslip branding (optional) – logo shown on both schedule and legacy templates
# Use absolute URL (e.g. https://yoursite.com/assets/logo.png) for downloaded HTML
# PAYSLIP_LOGO_URL="https://example.com/assets/company-logo.png"

# Optional: Redis (for caching/job queues)
# REDIS_URL="redis://localhost:6379"

# Optional: S3/MinIO (for artifact storage)
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="workforce-artifacts"
