# Admin Portal Environment
# Copy to .env and adjust as needed

# API base URL (optional) - when set, requests go directly to this URL.
# Must include /v1 (backend global prefix). Examples:
#   VITE_API_BASE_URL=http://localhost:4000/v1   (Docker backend)
#   VITE_API_BASE_URL=http://localhost:3000/v1   (local backend)
# When unset, dev/preview proxy /v1 to the backend (see VITE_PROXY_TARGET).

# Vite proxy target - backend URL for proxying /v1 requests (dev + preview).
# Default in vite.config.ts: http://localhost:4000 (matches docker-compose `app` port mapping).
# If you run Nest only on the host with PORT=3000:
# VITE_PROXY_TARGET=http://localhost:3000
