    "@prisma/client": "^7.1.0",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.4",
    "adm-zip": "^0.5.16",
