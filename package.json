{
  "name": "hubsec-workforce-platform",
  "version": "0.2.1",
  "description": "Multi-country workforce, payroll and compliance platform",
  "main": "dist/main.js",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:performance": "node test/performance/benchmark.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest-e2e.config.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:tax-tables": "ts-node prisma/seeds/tax-tables.seed.ts",
    "db:seed:ci-payroll-import": "ts-node prisma/scripts/ci-payroll-import-seed.ts",
    "db:reset-for-customer": "ts-node prisma/scripts/reset-for-customer.ts",
    "db:clear-customer-flag": "ts-node prisma/scripts/clear-customer-demo-block.ts",
    "bootstrap:admin": "ts-node prisma/scripts/bootstrap-admin.ts",
    "demo:seed": "ts-node prisma/scripts/demo-seed.ts",
    "demo:seed:recruitment-users": "ts-node prisma/scripts/ensure-recruitment-talent-users.ts",
    "db:studio": "prisma studio",
    "db:encrypt-accounts": "ts-node scripts/encrypt-existing-bank-accounts.ts",
    "qa:dashboard-access": "jest src/modules/dashboard/dashboard.service.spec.ts --passWithNoTests && ts-node scripts/dashboard-access-matrix.ts",
    "test:playwright:recruitment": "playwright test test/playwright/recruitment-rbac.spec.ts --project=chromium",
    "test:playwright:recruitment:live": "RECRUITMENT_LIVE_E2E=1 playwright test test/playwright/recruitment-authz-live.spec.ts --project=chromium",
    "test:playwright:payroll-imports": "playwright test test/playwright/payroll-import-consoles.spec.ts --project=chromium",
    "test:playwright:tta-rbac": "playwright test test/playwright/tax-table-authoring-rbac.spec.ts --project=chromium",
    "test:playwright:pr-rbac-gov-3": "playwright test test/playwright/pr-rbac-gov-3-override-authority.spec.ts --project=chromium",
    "test:playwright:statutory-config-copy": "playwright test test/playwright/statutory-config-country-copy.spec.ts --project=chromium",
    "verify:tta-rbac": "tsx scripts/verify-tta-rbac.ts",
    "check:tax-gov-2a-drift": "tsx scripts/check_tax_gov_2a_drift.ts",
    "check:statutory-config-country-copy-drift": "tsx scripts/check_statutory_config_country_copy_drift.ts",
    "check:payroll-governance-constitution-drift": "tsx scripts/check_payroll_governance_constitution_drift.ts",
    "check:payroll-import-drift": "tsx scripts/check_payroll_import_drift.ts",
    "check:payrun-execution-drift": "tsx scripts/check_payrun_execution_drift.ts",
    "check:payrun-cancel-drift": "tsx scripts/check_payrun_cancel_drift.ts",
    "check:payrun-financial-control-drift": "tsx scripts/check_payrun_financial_control_drift.ts",
    "check:payrun-bank-reconciliation-drift": "tsx scripts/check_payrun_bank_reconciliation_drift.ts",
    "check:payrun-gl-reconciliation-drift": "tsx scripts/check_payrun_gl_reconciliation_drift.ts",
    "check:payrun-closed-period-drift": "tsx scripts/check_payrun_closed_period_drift.ts",
    "check:payrun-post-reversal-impact-drift": "tsx scripts/check_payrun_post_reversal_impact_drift.ts",
    "check:payrun-governance-dashboard-drift": "tsx scripts/check_payrun_governance_dashboard_drift.ts",
    "check:payrun-governance-portfolio-drift": "tsx scripts/check_payrun_governance_portfolio_drift.ts",
    "check:payrun-governance-policy-drift": "tsx scripts/check_payrun_governance_policy_drift.ts",
    "check:payroll-container-drift": "tsx scripts/check_payroll_container_drift.ts",
    "check:rbac-role-policy-drift": "tsx scripts/check_rbac_role_policy_drift.ts",
    "check:rbac-override-test-fixture-drift": "tsx scripts/check_rbac_override_test_fixture_drift.ts",
    "verify:payroll-container-period-linkage": "tsx scripts/verify_payroll_container_period_linkage.ts",
    "backfill:pay-period-payroll-ids": "tsx scripts/backfill_pay_period_payroll_ids.ts"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:27991/git/ktwala/hubsec-workforce-platform"
  },
  "keywords": [
