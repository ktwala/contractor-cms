                "const empNo = pm.environment.get('empNoA');",
                "const found = (json.items || []).find(e => e.employee_no === empNo);",
                "pm.test('A appears in delta after termination', () => pm.expect(found).to.be.ok);",
                "pm.test('status is TERMINATED', () => pm.expect(found.status).to.eql('TERMINATED'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{igaToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/v1/hr/employees?changed_since={{a2}}&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "hr", "employees"],
              "query": [
                {"key": "changed_since", "value": "{{a2}}"},
                {"key": "limit", "value": "50"}
              ]
            }
          }
        },
        {
          "name": "HR Delta since A3 expect empty",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HR delta 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "const count = (json.items || []).length;",
                "pm.test('No false positives: empty or zero items', () => pm.expect(count).to.eql(0));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{igaToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/v1/hr/employees?changed_since={{a3}}&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "hr", "employees"],
              "query": [
                {"key": "changed_since", "value": "{{a3}}"},
                {"key": "limit", "value": "50"}
              ]
            }
          }
        }
      ]
    },
