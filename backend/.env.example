# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://contractor_cms:password@localhost:5433/contractor_cms?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# API Keys
API_KEY_SALT=your-api-key-salt-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# PR-DEMO-CONNECTOR-1 — demo UI controls + mock Oracle upstream (start: npm run mock:oracle)
DEMO_MODE=true
ORACLE_PROCUREMENT_REST_ENABLED=true
ORACLE_PROCUREMENT_REST_BASE_URL=http://localhost:8088/mock-oracle/procurement
ORACLE_PROCUREMENT_REST_SUPPLIERS_PATH=/suppliers
ORACLE_PROCUREMENT_REST_USERNAME=demo
ORACLE_PROCUREMENT_REST_PASSWORD=demo
HCM_ORACLE_REST_ENABLED=true
HCM_ORACLE_REST_BASE_URL=http://localhost:8088/mock-oracle/hcm
HCM_ORACLE_REST_WORKERS_PATH=/workers
HCM_ORACLE_REST_USERNAME=demo
HCM_ORACLE_REST_PASSWORD=demo
