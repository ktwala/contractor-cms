model BenefitRate {
  id                  String    @id @default(uuid())
  planId              String    @map("plan_id")
  optionId            String?   @map("option_id")
  rateType            String    @map("rate_type") // fixed_amount, percentage_of_salary, age_based, income_bracket, family_size
  employeeAmount      Decimal?  @map("employee_amount") @db.Decimal(18, 2)
  employerAmount      Decimal?  @map("employer_amount") @db.Decimal(18, 2)
  employeePercentage  Decimal?  @map("employee_percentage") @db.Decimal(10, 4)
  employerPercentage  Decimal?  @map("employer_percentage") @db.Decimal(10, 4)
  minIncome           Decimal?  @map("min_income") @db.Decimal(18, 2)
  maxIncome           Decimal?  @map("max_income") @db.Decimal(18, 2)
  minAge              Int?      @map("min_age")
  maxAge              Int?      @map("max_age")
  familySize          Int?      @map("family_size")
  monthlyCap          Decimal?  @map("monthly_cap") @db.Decimal(18, 2)
  annualCap           Decimal?  @map("annual_cap") @db.Decimal(18, 2)
  effectiveDate       DateTime  @map("effective_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  plan   BenefitPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  option BenefitPlanOption? @relation(fields: [optionId], references: [id])

  @@index([planId, effectiveDate])
  @@map("benefit_rates")
}

