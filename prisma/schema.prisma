}

model GlJournal {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  payrunId       String?   @map("payrun_id")
  reference      String
  description    String?
  journalDate    DateTime  @map("journal_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date
  status         String    @default("DRAFT") // DRAFT, POSTED, VOIDED
