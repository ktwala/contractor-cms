// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  PAYRUN_CREATED
  PAYRUN_CALCULATED
  PAYRUN_SUBMITTED
  PAYRUN_APPROVED
  PAYRUN_REJECTED
  PAYRUN_FINALIZED
  PAYRUN_PAID
  APPROVAL_REQUIRED
  APPROVAL_REMINDER
  APPROVAL_DELEGATED
  PAY_DATE_REMINDER
  SUBMISSION_DEADLINE
  PAYSLIP_AVAILABLE
  TAX_CERTIFICATE_AVAILABLE
  IMPORT_COMPLETED
  IMPORT_FAILED
  REPORT_READY
}

enum DeliveryChannel {
  EMAIL
  WEBHOOK
  IN_APP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  type        NotificationType
  title       String
  message     String
  data        Json                 @default("{}")
  channel     DeliveryChannel
  priority    NotificationPriority @default(NORMAL)
  status      NotificationStatus   @default(PENDING)
  sentAt      DateTime?            @map("sent_at")
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  user        User                 @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([status])
  @@map("notifications")
}

model NotificationPreference {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  enabled     Boolean          @default(true)
  channels    Json             @default("[]") // Array of {channel, enabled}
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

model Webhook {
  id              String             @id @default(uuid())
  legalEntityId   String?            @map("legal_entity_id")
  name            String
  description     String?
  url             String
  secret          String
  events          NotificationType[] @default([])
  headers         Json               @default("{}")
  active          Boolean            @default(true)
  lastTriggeredAt DateTime?          @map("last_triggered_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  legalEntity     LegalEntity?       @relation(fields: [legalEntityId], references: [id])

  @@index([legalEntityId, active])
  @@map("webhooks")
}

// ============================================================================
// IDEMPOTENCY
// ============================================================================

model IdempotencyKey {
  id           String   @id
  response     Json?
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
