// ============================================================================
// DATA IMPORT CONSOLE (Hubsec HCM onboarding)
// ============================================================================

enum DataImportDatasetType {
  LEGAL_ENTITIES
  ORG_UNITS
  COST_CENTERS
  EMPLOYEES
  EMPLOYMENTS
  EMPLOYMENT_ASSIGNMENTS
  POSITIONS
  MANAGER_RELATIONSHIPS
  PAY_GROUPS
  PAYROLL_SUPPLEMENTAL
  PAYROLL_OPENING_BALANCES
}

enum DataImportStatus {
  UPLOADED
  PARSED
  VALIDATING
  VALIDATED
  HAS_ERRORS
  APPROVED
  PUBLISHING
  PUBLISHED
  CANCELLING
  CANCELLED
  FAILED
}

enum DataImportRowStatus {
  PENDING
  VALID
  INVALID
  PUBLISHED
  SKIPPED
}

model DataImportJob {
  id                  String                @id @default(uuid())
  tenantId            String                @map("tenant_id")
  datasetType         DataImportDatasetType  @map("dataset_type")
  fileName            String                @map("file_name")
  fileStoragePath     String?               @map("file_storage_path")
  status              DataImportStatus      @default(UPLOADED)
  uploadedByUserId    String                @map("uploaded_by_user_id")
  uploadedAt          DateTime              @default(now()) @map("uploaded_at")
  validatedAt         DateTime?             @map("validated_at")
  approvedAt          DateTime?             @map("approved_at")
  approvedByUserId    String?               @map("approved_by_user_id")
  publishedAt         DateTime?             @map("published_at")
  publishedByUserId   String?               @map("published_by_user_id")
  summaryJson         Json?                 @map("summary_json")
  publishSummaryJson  Json?                 @map("publish_summary_json")
  contextJson         Json?                 @map("context_json")

  rowsTotal           Int                   @default(0) @map("rows_total")
  rowsProcessed       Int                   @default(0) @map("rows_processed")
  rowsValid           Int                   @default(0) @map("rows_valid")
  rowsInvalid         Int                   @default(0) @map("rows_invalid")
  pipelineStartedAt   DateTime?             @map("pipeline_started_at")
  pipelineFinishedAt  DateTime?             @map("pipeline_finished_at")
  cancelledAt         DateTime?             @map("cancelled_at")
  cancelledByUserId   String?               @map("cancelled_by_user_id")
  cancelReason        String?               @map("cancel_reason")
  finalSummaryJson    Json?                 @map("final_summary_json")

  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  rows   DataImportRow[]
  errors DataImportError[]

  @@index([tenantId, datasetType, status])
  @@index([uploadedByUserId])
  @@index([status])
  @@map("data_import_jobs")
