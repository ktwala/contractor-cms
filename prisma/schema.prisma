  updatedAt        DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, taxYear])
  @@index([employeeId])
  @@map("employee_payroll_opening_balances")
}

model EmployeeLeaveOpeningBalance {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  leaveType   String   @map("leave_type")
  balance     Decimal  @db.Decimal(10, 2)
  unit        String?  @default("DAYS")
  asOfDate    DateTime @map("as_of_date") @db.Date
  importJobId String?  @map("import_job_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, leaveType, asOfDate])
  @@index([employeeId])
  @@map("employee_leave_opening_balances")
}

model EmployeeLoanOpeningBalance {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  deductionCode     String   @map("deduction_code")
  remainingBalance  Decimal  @map("remaining_balance") @db.Decimal(18, 2)
  installmentAmount Decimal? @map("installment_amount") @db.Decimal(18, 2)
  originalBalance   Decimal? @map("original_balance") @db.Decimal(18, 2)
  referenceNo       String?  @map("reference_no")
  asOfDate          DateTime @map("as_of_date") @db.Date
  importJobId       String?  @map("import_job_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, deductionCode, asOfDate])
  @@index([employeeId])
  @@map("employee_loan_opening_balances")
}

// ─── Statutory Returns v1 ───────────────────────────────────────────────────

model StatutoryReturn {
  id                   String    @id @default(uuid())
  countryCode          String    @map("country_code")
  legalEntityId        String    @map("legal_entity_id")
  payGroupId           String?   @map("pay_group_id")
  returnCode           String    @map("return_code")
  returnLabel          String    @map("return_label")
  periodKey            String    @map("period_key")
  periodStart          DateTime  @map("period_start") @db.Date
  periodEnd            DateTime  @map("period_end") @db.Date
  currency             String
  status               String    @default("draft")
  totalDue             Decimal   @map("total_due") @db.Decimal(18, 2)
  employeeCount        Int       @map("employee_count")
  sourcePayrunIds      Json      @map("source_payrun_ids")
  displaySchemaKey     String?   @map("display_schema_key")
  statutoryProfileKey  String    @map("statutory_profile_key")
  countryPackVersion   String?   @map("country_pack_version")
  generatedAt          DateTime? @map("generated_at")
  generatedByUserId    String?   @map("generated_by_user_id")
  reviewedAt           DateTime? @map("reviewed_at")
  reviewedByUserId     String?   @map("reviewed_by_user_id")
  approvedAt           DateTime? @map("approved_at")
  approvedByUserId     String?   @map("approved_by_user_id")
  submittedAt          DateTime? @map("submitted_at")
  submittedByUserId    String?   @map("submitted_by_user_id")
  submissionReference  String?   @map("submission_reference")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  acknowledgedByUserId String?   @map("acknowledged_by_user_id")
  evidenceBundleId     String?   @map("evidence_bundle_id")
  amendsReturnId       String?   @map("amends_return_id")
  versionNumber        Int       @default(1) @map("version_number")
  filingDueDate        DateTime? @map("filing_due_date") @db.Date
  filingAuthority      String?   @map("filing_authority")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  items          StatutoryReturnItem[]
  workflowEvents StatutoryWorkflowEvent[]
  evidenceBundle StatutoryEvidenceBundle?
  amendsReturn   StatutoryReturn?  @relation("AmendmentChain", fields: [amendsReturnId], references: [id])
  amendedBy      StatutoryReturn[] @relation("AmendmentChain")

  @@index([countryCode, periodKey])
  @@index([legalEntityId, returnCode])
  @@index([status])
  @@index([amendsReturnId])
  @@map("statutory_returns")
}

model StatutoryReturnItem {
  id                String  @id @default(uuid())
  statutoryReturnId String  @map("statutory_return_id")
  itemCode          String  @map("item_code")
  itemLabel         String  @map("item_label")
  amount            Decimal @db.Decimal(18, 2)
  currency          String
  sourceLineCodes   Json    @map("source_line_codes")
  employeeCount     Int?    @map("employee_count")
  sortOrder         Int     @map("sort_order")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  statutoryReturn StatutoryReturn @relation(fields: [statutoryReturnId], references: [id], onDelete: Cascade)

  @@index([statutoryReturnId])
  @@map("statutory_return_items")
}

model StatutoryEvidenceBundle {
  id                String   @id @default(uuid())
  statutoryReturnId String   @unique @map("statutory_return_id")
  countryCode       String   @map("country_code")
  returnCode        String   @map("return_code")
  periodKey         String   @map("period_key")
  legalEntityId     String   @map("legal_entity_id")
  artifacts         Json
  createdByUserId   String?  @map("created_by_user_id")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  statutoryReturn StatutoryReturn @relation(fields: [statutoryReturnId], references: [id], onDelete: Cascade)

  @@map("statutory_evidence_bundles")
}

model StatutoryWorkflowEvent {
  id                String   @id @default(uuid())
  statutoryReturnId String   @map("statutory_return_id")
  eventType         String   @map("event_type")
  fromStatus        String?  @map("from_status")
  toStatus          String   @map("to_status")
  performedByUserId String?  @map("performed_by_user_id")
  performedAt       DateTime @default(now()) @map("performed_at")
  comment           String?
  metadata          Json?

  statutoryReturn StatutoryReturn @relation(fields: [statutoryReturnId], references: [id], onDelete: Cascade)

  @@index([statutoryReturnId])
  @@map("statutory_workflow_events")
}

// ============================================================================
// TAX TABLE AUTHORING (upstream governance for TaxTableSet)
// ============================================================================

model TaxTableAuthoringVersion {
  id                     String    @id @default(uuid())
  countryCode            String    @map("country_code")
  tableType              String    @map("table_type")
  taxYear                String    @map("tax_year")
  effectiveFrom          DateTime  @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  status                 String    @default("DRAFT")
  sourceType             String    @map("source_type")
  sourceReference        String?   @map("source_reference")
  sourceChecksum         String?   @map("source_checksum")
  templateId             String?   @map("template_id")
  templateCode           String?   @map("template_code")
  templateVersion        String?   @map("template_version")
  copiedFromAuthoringId  String?   @map("copied_from_authoring_id")
  publishedTaxTableSetId String?   @map("published_tax_table_set_id")
  publishReason          String?   @map("publish_reason")

  createdByUserId        String    @map("created_by_user_id")
  reviewedByUserId       String?   @map("reviewed_by_user_id")
  publishedByUserId      String?   @map("published_by_user_id")

  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  publishedAt            DateTime? @map("published_at")

  brackets               TaxTableAuthoringBracket[]
  fields                 TaxTableAuthoringField[]
  auditEvents            TaxTableAuthoringAuditEvent[]

  @@index([countryCode, tableType, taxYear, status])
  @@index([countryCode, tableType, effectiveFrom])
  @@map("tax_table_authoring_versions")
}

model TaxTableAuthoringBracket {
  id                    String   @id @default(uuid())
  authoringVersionId    String   @map("authoring_version_id")
  seqNo                 Int      @map("seq_no")
  bracketFrom           Decimal  @map("bracket_from") @db.Decimal(18, 2)
  bracketTo             Decimal? @map("bracket_to") @db.Decimal(18, 2)
  marginalRate          Decimal  @map("marginal_rate") @db.Decimal(8, 5)
  baseTax               Decimal  @map("base_tax") @db.Decimal(18, 2)
  derivedBaseTax        Decimal? @map("derived_base_tax") @db.Decimal(18, 2)
  isOpenEnded           Boolean  @default(false) @map("is_open_ended")
  baseTaxOverrideReason String?  @map("base_tax_override_reason")

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  version               TaxTableAuthoringVersion @relation(fields: [authoringVersionId], references: [id], onDelete: Cascade)

  @@index([authoringVersionId, seqNo])
  @@map("tax_table_authoring_brackets")
}

model TaxTableAuthoringField {
  id                 String   @id @default(uuid())
  authoringVersionId String   @map("authoring_version_id")
  fieldCode          String   @map("field_code")
  fieldValueJson     Json     @map("field_value_json")
  createdAt          DateTime @default(now()) @map("created_at")

  version            TaxTableAuthoringVersion @relation(fields: [authoringVersionId], references: [id], onDelete: Cascade)

  @@index([authoringVersionId, fieldCode])
  @@map("tax_table_authoring_fields")
}

model TaxTableAuthoringAuditEvent {
  id                 String   @id @default(uuid())
  authoringVersionId String   @map("authoring_version_id")
  eventType          String   @map("event_type")
  actorUserId        String   @map("actor_user_id")
  payloadJson        Json?    @map("payload_json")
  createdAt          DateTime @default(now()) @map("created_at")

  version            TaxTableAuthoringVersion @relation(fields: [authoringVersionId], references: [id], onDelete: Cascade)

  @@index([authoringVersionId, createdAt])
  @@map("tax_table_authoring_audit_events")
}

// ============================================================================
// TAX TABLE IMPACT ANALYSIS (persisted runs, row snapshots, reviews)
// ============================================================================

model TaxTableImpactAnalysisRun {
  id                         String   @id @default(uuid())
  authoringVersionId         String   @map("authoring_version_id")
  countryCode                String   @map("country_code")
  basisMode                  String   @map("basis_mode")
  payGroupId                 String?  @map("pay_group_id")
  payrunId                   String?  @map("payrun_id")
  legalEntityId              String?  @map("legal_entity_id")
  limitValue                 Int?     @map("limit_value")
  affectedOnly               Boolean  @default(false) @map("affected_only")
  minAbsoluteDelta           Decimal? @map("min_absolute_delta") @db.Decimal(18, 2)

  sourceDraftChecksum        String?  @map("source_draft_checksum")
  sourceRuntimeTaxTableSetId String?  @map("source_runtime_tax_table_set_id")
  sourceRuntimeChecksum      String?  @map("source_runtime_checksum")

  employeesAnalyzed          Int      @map("employees_analyzed")
  employeesAffected          Int      @map("employees_affected")
  employeesSkipped           Int      @map("employees_skipped")

  totalBaselinePaye          Decimal  @map("total_baseline_paye") @db.Decimal(18, 2)
  totalDraftPaye             Decimal  @map("total_draft_paye") @db.Decimal(18, 2)
  totalPayeDelta             Decimal  @map("total_paye_delta") @db.Decimal(18, 2)
  averageDeltaAll            Decimal  @map("average_delta_all") @db.Decimal(18, 2)
  averageDeltaAffected       Decimal  @map("average_delta_affected") @db.Decimal(18, 2)

  biggestIncreaseJson        Json?    @map("biggest_increase_json")
  biggestDecreaseJson        Json?    @map("biggest_decrease_json")
  bucketSummaryJson          Json?    @map("bucket_summary_json")
  warningsJson               Json?    @map("warnings_json")

  runByUserId                String   @map("run_by_user_id")
  runAt                      DateTime @default(now()) @map("run_at")

  rows                       TaxTableImpactAnalysisRowSnapshot[]
  reviews                    TaxTableImpactAnalysisReview[]

  @@index([authoringVersionId, runAt])
  @@index([countryCode, runAt])
  @@map("tax_table_impact_analysis_runs")
}

model TaxTableImpactAnalysisRowSnapshot {
  id                   String   @id @default(uuid())
  runId                String   @map("run_id")

  employeeId           String   @map("employee_id")
  employeeNumber       String?  @map("employee_number")
  employeeName         String?  @map("employee_name")
  legalEntityName      String?  @map("legal_entity_name")
  payGroupName         String?  @map("pay_group_name")

  taxableEarnings      Decimal  @map("taxable_earnings") @db.Decimal(18, 2)
  baselinePaye         Decimal  @map("baseline_paye") @db.Decimal(18, 2)
  draftPaye            Decimal  @map("draft_paye") @db.Decimal(18, 2)
  deltaPaye            Decimal  @map("delta_paye") @db.Decimal(18, 2)
  absoluteDelta        Decimal  @map("absolute_delta") @db.Decimal(18, 2)
  direction            String

  baselineBracketLabel String?  @map("baseline_bracket_label")
  draftBracketLabel    String?  @map("draft_bracket_label")

  run                  TaxTableImpactAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, employeeId])
  @@index([runId, direction])
  @@map("tax_table_impact_analysis_row_snapshots")
}

model TaxTableImpactAnalysisReview {
  id                  String   @id @default(uuid())
  impactAnalysisRunId String   @map("impact_analysis_run_id")
  authoringVersionId  String   @map("authoring_version_id")
  reviewStatus        String   @map("review_status")
  reviewComment       String?  @map("review_comment")
  reviewedByUserId    String   @map("reviewed_by_user_id")
  reviewedAt          DateTime @default(now()) @map("reviewed_at")

  run                 TaxTableImpactAnalysisRun @relation(fields: [impactAnalysisRunId], references: [id], onDelete: Cascade)

  @@index([authoringVersionId, reviewedAt])
  @@index([impactAnalysisRunId, reviewedAt])
  @@map("tax_table_impact_analysis_reviews")
}

// ─── CTC Optimiser ───────────────────────────────────────────────────

model CtcOptimiserRun {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  legalEntityId      String?   @map("legal_entity_id")
  employeeId         String?   @map("employee_id")
  countryCode        String    @map("country_code")
  taxYear            String    @map("tax_year")
  payFrequency       String    @map("pay_frequency")
  optimisationMode   String    @map("optimisation_mode")
  inputJson          Json      @map("input_json")
  routingJson        Json?     @map("routing_json")
  assumptionsJson    Json?     @map("assumptions_json")
  status             String    @default("COMPLETED")
  selectedScenarioId String?   @map("selected_scenario_id")
  createdByUserId    String    @map("created_by_user_id")
  approvedByUserId   String?   @map("approved_by_user_id")
  appliedByUserId    String?   @map("applied_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  approvedAt         DateTime? @map("approved_at")
  appliedAt          DateTime? @map("applied_at")

  scenarios          CtcOptimiserScenario[]
  decisions          CtcOptimiserDecision[]

  @@index([tenantId, createdAt])
  @@index([employeeId, createdAt])
  @@index([legalEntityId, createdAt])
  @@map("ctc_optimiser_runs")
}

model CtcOptimiserScenario {
  id                 String   @id @default(uuid())
  runId              String   @map("run_id")
  scenarioCode       String   @map("scenario_code")
  rank               Int?
  isValid            Boolean  @default(true) @map("is_valid")
  policyStatus       String   @default("PASS") @map("policy_status")
  inputBreakdownJson Json     @map("input_breakdown_json")
  payrollOutputJson  Json     @map("payroll_output_json")
  explanationsJson   Json?    @map("explanations_json")
  warningsJson       Json?    @map("warnings_json")
  scoreTotal         Float?   @map("score_total")
  scoreBreakdownJson Json?    @map("score_breakdown_json")
  checksum           String?
  createdAt          DateTime @default(now()) @map("created_at")

  run                CtcOptimiserRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, rank])
  @@map("ctc_optimiser_scenarios")
}

model CtcOptimiserDecision {
  id              String    @id @default(uuid())
  runId           String    @map("run_id")
  scenarioId      String    @map("scenario_id")
  decisionType    String    @map("decision_type")
  decisionStatus  String    @default("PENDING") @map("decision_status")
  decidedByUserId String?   @map("decided_by_user_id")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  decidedAt       DateTime? @map("decided_at")

  run             CtcOptimiserRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("ctc_optimiser_decisions")
}
