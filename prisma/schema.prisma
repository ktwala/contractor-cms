// ============================================================================
// PERFORMANCE MANAGEMENT
// ============================================================================

model PerformanceCycle {
  id                    String    @id @default(uuid())
  name                  String
  description           String?   @db.Text
  cycleType             String    @map("cycle_type") // annual, semi_annual, quarterly
  startDate             DateTime  @map("start_date")
  endDate               DateTime  @map("end_date")
  reviewStartDate       DateTime? @map("review_start_date")
  reviewEndDate         DateTime? @map("review_end_date")
  selfAssessmentEnabled Boolean   @default(true) @map("self_assessment_enabled")
  peerFeedbackEnabled   Boolean   @default(false) @map("peer_feedback_enabled")
  managerReviewEnabled  Boolean   @default(true) @map("manager_review_enabled")
  goalsRequired         Boolean   @default(true) @map("goals_required")
  status                String    @default("draft") // draft, active, review, completed, archived
  country               Country?
  legalEntityId         String?   @map("legal_entity_id")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  goals   PerformanceGoal[]
  reviews PerformanceReview[]

  @@index([status])
  @@map("performance_cycles")
}

model PerformanceGoal {
  id                   String    @id @default(uuid())
  employeeId           String    @map("employee_id")
  cycleId              String?   @map("cycle_id")
  managerId            String?   @map("manager_id")
  title                String
  description          String?   @db.Text
  goalType             String    @default("individual") @map("goal_type") // individual, team, company
  category             String?   // performance, development, project
  metric               String?
  targetValue          String?   @map("target_value")
  currentValue         String?   @map("current_value")
  startDate            DateTime? @map("start_date")
  dueDate              DateTime? @map("due_date")
  completedAt          DateTime? @map("completed_at")
  weight               Int       @default(0) // percentage weight
  completionPercentage Int       @default(0) @map("completion_percentage")
  status               String    @default("active") // active, completed, cancelled
  employeeComments     String?   @map("employee_comments") @db.Text
  managerComments      String?   @map("manager_comments") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  employee Employee          @relation("EmployeeGoals", fields: [employeeId], references: [id])
  manager  Employee?         @relation("ManagerGoals", fields: [managerId], references: [id])
  cycle    PerformanceCycle? @relation(fields: [cycleId], references: [id])

  @@index([employeeId])
  @@index([cycleId])
  @@map("performance_goals")
}

model PerformanceReview {
  id                       String    @id @default(uuid())
  reviewNumber             String?   @unique @map("review_number")
  employeeId               String    @map("employee_id")
  cycleId                  String?   @map("cycle_id")
  managerId                String?   @map("manager_id")
  reviewType               String    @default("manager_review") @map("review_type")
  reviewPeriodStart        DateTime? @map("review_period_start")
  reviewPeriodEnd          DateTime? @map("review_period_end")
  status                   String    @default("not_started") // not_started, in_progress, submitted, completed
  selfAssessmentDate       DateTime? @map("self_assessment_date")
  managerReviewDate        DateTime? @map("manager_review_date")
  overallRating            Int?      @map("overall_rating")
  goalsRating              Int?      @map("goals_rating")
  competenciesRating       Int?      @map("competencies_rating")
  employeeComments         String?   @map("employee_comments") @db.Text
  managerComments          String?   @map("manager_comments") @db.Text
  performanceCategory      String?   @map("performance_category") // exceeds, meets, below
  recommendedForPromotion  Boolean   @default(false) @map("recommended_for_promotion")
  recommendedSalaryIncrease Decimal? @map("recommended_salary_increase") @db.Decimal(5, 2)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  employee Employee          @relation("EmployeeReviews", fields: [employeeId], references: [id])
  manager  Employee?         @relation("ManagerReviews", fields: [managerId], references: [id])
  cycle    PerformanceCycle? @relation(fields: [cycleId], references: [id])
  feedback PerformanceFeedback[]

  @@index([employeeId])
  @@index([cycleId])
  @@map("performance_reviews")
}

model PerformanceFeedback {
  id                    String    @id @default(uuid())
  reviewId              String?   @map("review_id")
  employeeId            String    @map("employee_id")
  feedbackProviderId    String    @map("feedback_provider_id")
  feedbackType          String    @map("feedback_type") // self, peer, manager, 360
  relationship          String?   // Peer, Direct Report, Manager, etc.
  overallRating         Int?      @map("overall_rating")
  strengths             String?   @db.Text
  areasForImprovement   String?   @map("areas_for_improvement") @db.Text
  collaborationFeedback String?   @map("collaboration_feedback") @db.Text
  communicationFeedback String?   @map("communication_feedback") @db.Text
  status                String    @default("requested") // requested, submitted
  requestedDate         DateTime? @map("requested_date")
  submittedDate         DateTime? @map("submitted_date")
  createdAt             DateTime  @default(now()) @map("created_at")

  review   PerformanceReview? @relation(fields: [reviewId], references: [id])
  employee Employee           @relation("FeedbackForEmployee", fields: [employeeId], references: [id])
  provider Employee           @relation("FeedbackByEmployee", fields: [feedbackProviderId], references: [id])

  @@index([employeeId])
  @@index([reviewId])
  @@map("performance_feedback")
}

