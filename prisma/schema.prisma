  totalRemuneration         Decimal   @default(0) @map("total_remuneration") @db.Decimal(18, 2)
  taxableIncome             Decimal   @default(0) @map("taxable_income") @db.Decimal(18, 2)
  totalTax                  Decimal   @default(0) @map("total_tax") @db.Decimal(18, 2)
  certificateNumber         String    @map("certificate_number")
  issueDate                 DateTime? @map("issue_date") @db.Date
  status                    String    @default("draft") // draft, generated, issued, cancelled
  generatedAt               DateTime? @map("generated_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  taxPeriod   TaxPeriod   @relation(fields: [taxPeriodId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@unique([taxPeriodId, employeeId])
  @@index([employeeId])
  @@index([legalEntityId])
  @@index([status])
  @@map("irp5_certificates")
}

// ============================================================================
// SARS: EMP201 RETURNS
// ============================================================================

model EMP201Return {
  id                   String    @id @default(uuid())
  taxPeriodId          String    @map("tax_period_id")
  legalEntityId        String    @map("legal_entity_id")
  legalEntity          LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  employerPayeNumber   String?   @map("employer_paye_number")
  employerTaxNumber    String?   @map("employer_tax_number")
  employerName         String?   @map("employer_name")
  employerTradingName  String?   @map("employer_trading_name")
  taxYear              String    @map("tax_year")
  monthNumber          Int       @map("month_number")
  periodStart          DateTime  @map("period_start") @db.Date
  periodEnd            DateTime  @map("period_end") @db.Date
  submissionDueDate    DateTime? @map("submission_due_date") @db.Date
  totalEmployees       Int       @default(0) @map("total_employees")
  localEmployees       Int       @default(0) @map("local_employees")
  foreignEmployees     Int       @default(0) @map("foreign_employees")
  payeCurrentMonth     Decimal   @default(0) @map("paye_current_month") @db.Decimal(18, 2)
  payeAdjustments      Decimal   @default(0) @map("paye_adjustments") @db.Decimal(18, 2)
  payeTotal            Decimal   @default(0) @map("paye_total") @db.Decimal(18, 2)
  sdlCurrentMonth      Decimal   @default(0) @map("sdl_current_month") @db.Decimal(18, 2)
  sdlAdjustments       Decimal   @default(0) @map("sdl_adjustments") @db.Decimal(18, 2)
  sdlTotal             Decimal   @default(0) @map("sdl_total") @db.Decimal(18, 2)
  uifEmployeeCurrent   Decimal   @default(0) @map("uif_employee_current") @db.Decimal(18, 2)
  uifEmployerCurrent   Decimal   @default(0) @map("uif_employer_current") @db.Decimal(18, 2)
  uifAdjustments       Decimal   @default(0) @map("uif_adjustments") @db.Decimal(18, 2)
  uifTotal             Decimal   @default(0) @map("uif_total") @db.Decimal(18, 2)
  etiCurrentMonth      Decimal   @default(0) @map("eti_current_month") @db.Decimal(18, 2)
  etiAdjustments       Decimal   @default(0) @map("eti_adjustments") @db.Decimal(18, 2)
  etiTotal             Decimal   @default(0) @map("eti_total") @db.Decimal(18, 2)
  totalLiability       Decimal   @default(0) @map("total_liability") @db.Decimal(18, 2)
  country              String    @default("ZAF")
  status               String    @default("draft") // draft, submitted, paid
  generatedByUserId    String?   @map("generated_by_user_id")
  generatedAt          DateTime? @map("generated_at")
  submittedByUserId    String?   @map("submitted_by_user_id")
  submittedAt          DateTime? @map("submitted_at")
  submittedBy          String?   @map("submitted_by") // legacy, prefer submittedByUserId
  sarsReferenceNumber  String?   @map("sars_reference_number")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@unique([taxPeriodId, legalEntityId])
  @@index([taxYear, monthNumber])
  @@index([status])
  @@index([legalEntityId])
  @@map("emp201_returns")
}

// ============================================================================
// SARS: EMP501 RECONCILIATION
// ============================================================================

model EMP501Reconciliation {
  id              String    @id @default(uuid())
  taxPeriodId     String    @map("tax_period_id")
  legalEntityId   String    @map("legal_entity_id")
  legalEntity     LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  taxYear         String    @map("tax_year")
  status          String    @default("pending") // pending, discrepancies_found, reconciled, approved
  totalEmployees  Int       @default(0) @map("total_employees")
  totalLiability  Decimal   @default(0) @map("total_liability") @db.Decimal(18, 2)
  totalPaye       Decimal   @default(0) @map("total_paye") @db.Decimal(18, 2)
  totalUif        Decimal   @default(0) @map("total_uif") @db.Decimal(18, 2)
  totalSdl        Decimal   @default(0) @map("total_sdl") @db.Decimal(18, 2)
  irp5Count       Int       @default(0) @map("irp5_count")
  emp201Count     Int       @default(0) @map("emp201_count")
  discrepancies   Json?
  generatedByUserId String? @map("generated_by_user_id")
  generatedAt     DateTime? @map("generated_at")
  submittedByUserId String? @map("submitted_by_user_id")
  submittedAt     DateTime? @map("submitted_at")
  approvedByUserId  String? @map("approved_by_user_id")
  approvedAt      DateTime? @map("approved_at")
  reconciledBy    String?   @map("reconciled_by") // legacy, prefer approvedByUserId
  reconciledAt    DateTime? @map("reconciled_at")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@unique([taxPeriodId, legalEntityId])
  @@index([taxYear])
  @@index([status])
  @@index([legalEntityId])
  @@map("emp501_reconciliations")
}

// ============================================================================
// SARS: VALIDATION
// ============================================================================

model SarsValidationRule {
  id              String   @id @default(uuid())
  ruleCode        String   @unique @map("rule_code")
  ruleName        String   @map("rule_name")
  ruleDescription String?  @map("rule_description") @db.Text
  appliesTo       String   @map("applies_to") // irp5, emp201, emp501, all
  severity        String   @default("error") // error, warning
  validationLogic Json?    @map("validation_logic")
  errorMessage    String   @map("error_message")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  results SarsValidationResult[]

  @@index([appliesTo, isActive])
  @@map("sars_validation_rules")
}

model SarsValidationResult {
  id              String   @id @default(uuid())
  validationRunId String   @map("validation_run_id")
  ruleId          String   @map("rule_id")
  documentType    String   @map("document_type")
  documentId      String   @map("document_id")
  passed          Boolean
  severity        String
  errorMessage    String?  @map("error_message")
  fieldName       String?  @map("field_name")
  expectedValue   String?  @map("expected_value")
  actualValue     String?  @map("actual_value")
  createdAt       DateTime @default(now()) @map("created_at")

  rule SarsValidationRule @relation(fields: [ruleId], references: [id])

  @@index([validationRunId])
  @@index([documentType, documentId])
  @@map("sars_validation_results")
}

// ============================================================================
// SARS: SUBMISSIONS
// ============================================================================

model SarsSubmission {
  id               String    @id @default(uuid())
  submissionType   String    @map("submission_type") // IRP5, EMP201, EMP501
  documentId       String    @map("document_id")
  legalEntityId    String    @map("legal_entity_id")
  legalEntity      LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  submittedBy      String    @map("submitted_by")
  submissionMethod String    @map("submission_method") // manual, efiling, api
  status           String    @default("pending") // pending, submitted, accepted, rejected
  sarsReference    String?   @map("sars_reference")
  responseMessage  String?   @map("response_message") @db.Text
  submittedAt      DateTime? @map("submitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([submissionType, documentId])
  @@index([legalEntityId])
  @@index([status])
  @@map("sars_submissions")
}

model SarsSubmissionQueue {
  id                    String    @id @default(uuid())
  batchId               String    @map("batch_id")
  documentType          String    @map("document_type")
  documentId            String    @map("document_id")
  legalEntityId         String    @map("legal_entity_id")
  legalEntity           LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  priority              Int       @default(5)
  status                String    @default("queued") // queued, processing, completed, failed, cancelled
  queuedBy              String    @map("queued_by")
  processingStartedAt   DateTime? @map("processing_started_at")
  processingCompletedAt DateTime? @map("processing_completed_at")
  sarsReferenceNumber   String?   @map("sars_reference_number")
  submissionResult      Json?     @map("submission_result")
  errorMessage          String?   @map("error_message") @db.Text
  lastErrorAt           DateTime? @map("last_error_at")
  retryCount            Int       @default(0) @map("retry_count")
  maxRetries            Int       @default(3) @map("max_retries")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([batchId, status])
  @@index([legalEntityId])
  @@index([status, priority])
  @@map("sars_submission_queue")
}

// ============================================================================
// RECRUITMENT: CANDIDATES & APPLICATIONS
// ============================================================================

model Candidate {
  id             String    @id @default(uuid())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  phone          String?
  resumeUrl      String?   @map("resume_url")
  linkedinUrl    String?   @map("linkedin_url")
  source         String?   // referral, linkedin, job_board, etc.
  skills         Json?     // array of skill strings
  experience     Json?     // work experience array
  education      Json?     // education history
  currentSalary  Decimal?  @map("current_salary") @db.Decimal(15, 2)
  expectedSalary Decimal?  @map("expected_salary") @db.Decimal(15, 2)
  noticePeriod   String?   @map("notice_period")
  status         String    @default("active") // active, hired, rejected, withdrawn
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  applications JobApplication[]
  interviews   Interview[]
  offers       JobOffer[]

  @@index([email])
  @@index([status])
  @@map("candidates")
}

model JobRequisition {
  id                String    @id @default(uuid())
  requisitionNumber String    @unique @map("requisition_number")
  title             String
  department        String?
  legalEntityId     String?   @map("legal_entity_id")
  hiringManagerId   String?   @map("hiring_manager_id")
  description       String?   @db.Text
  requirements      Json?     // array of requirements
  responsibilities  Json?     // array of responsibilities
  salaryMin         Decimal?  @map("salary_min") @db.Decimal(15, 2)
  salaryMax         Decimal?  @map("salary_max") @db.Decimal(15, 2)
  employmentType    String?   @map("employment_type")
  location          String?
  workLocationId    String?   @map("work_location_id")
  remote            Boolean   @default(false)
  hybrid            Boolean   @default(false)
  positions         Int       @default(1)
  filledPositions   Int       @default(0) @map("filled_positions")
  priority          String    @default("normal") // low, normal, high, urgent
  status            String    @default("draft") // draft, open, on_hold, closed, cancelled
  publishedAt       DateTime? @map("published_at")
  closingDate       DateTime? @map("closing_date")
  createdBy         String?   @map("created_by")
  country           Country?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  applications JobApplication[]
  offers       JobOffer[]

  legalEntity   LegalEntity?    @relation(fields: [legalEntityId], references: [id])
  workLocation  WorkLocation?   @relation(fields: [workLocationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([department])
  @@index([workLocationId])
  @@map("job_requisitions")
}

model JobApplication {
  id              String    @id @default(uuid())
  candidateId     String    @map("candidate_id")
  requisitionId   String    @map("requisition_id")
  applicationDate DateTime  @default(now()) @map("application_date")
  status          String    @default("new") // new, screening, interview, offer, hired, rejected
  stage           String    @default("applied") // applied, phone_screen, interview, final, offer
  rating          Int?      // 1-5 rating
  notes           String?   @db.Text
  rejectionReason String?   @map("rejection_reason")
  source          String?   // how they applied
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate   Candidate      @relation(fields: [candidateId], references: [id])
  requisition JobRequisition @relation(fields: [requisitionId], references: [id])
  interviews  Interview[]

  @@unique([candidateId, requisitionId])
  @@index([status])
  @@map("job_applications")
}

model Interview {
  id              String    @id @default(uuid())
  candidateId     String    @map("candidate_id")
  applicationId   String?   @map("application_id")
  interviewType   String    @map("interview_type") // phone, video, onsite, panel, technical
  scheduledDate   DateTime  @map("scheduled_date")
  scheduledTime   String?   @map("scheduled_time")
  duration        Int       @default(60) // minutes
  location        String?
  meetingLink     String?   @map("meeting_link")
  interviewerIds  Json?     @map("interviewer_ids") // array of user/employee IDs
  status          String    @default("scheduled") // scheduled, completed, cancelled, no_show
  notes           String?   @db.Text
  overallRating   Int?      @map("overall_rating")
  recommendation  String?   // strong_hire, hire, no_hire, strong_no_hire
  completedAt     DateTime? @map("completed_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate   Candidate       @relation(fields: [candidateId], references: [id])
  application JobApplication? @relation(fields: [applicationId], references: [id])
  feedback    InterviewFeedback[]

  @@index([candidateId])
  @@index([scheduledDate])
  @@map("interviews")
}

model InterviewFeedback {
  id              String   @id @default(uuid())
  interviewId     String   @map("interview_id")
  interviewerId   String   @map("interviewer_id")
  overallRating   Int?     @map("overall_rating")
  technicalRating Int?     @map("technical_rating")
  cultureFitRating Int?    @map("culture_fit_rating")
  communicationRating Int? @map("communication_rating")
  strengths       String?  @db.Text
  weaknesses      String?  @db.Text
  recommendation  String?  // strong_hire, hire, no_hire, strong_no_hire
  notes           String?  @db.Text
  submittedAt     DateTime @default(now()) @map("submitted_at")

  interview Interview @relation(fields: [interviewId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_feedback")
}

model JobOffer {
  id              String    @id @default(uuid())
  offerNumber     String    @unique @map("offer_number")
  candidateId     String    @map("candidate_id")
  requisitionId   String    @map("requisition_id")
  position        String
  department      String?
  baseSalary      Decimal   @map("base_salary") @db.Decimal(15, 2)
  currency        String    @default("ZAR")
  bonus           Decimal?  @db.Decimal(15, 2)
  benefits        Json?     // benefits package details
  startDate       DateTime? @map("start_date")
  expiryDate      DateTime? @map("expiry_date")
  status          String    @default("draft") // draft, pending_approval, sent, accepted, rejected, expired, withdrawn
  sentAt          DateTime? @map("sent_at")
  respondedAt     DateTime? @map("responded_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectionReason String?   @map("rejection_reason")
  notes           String?   @db.Text
  offerLetterUrl  String?   @map("offer_letter_url")
  createdBy       String?   @map("created_by")
  approvedBy      String?   @map("approved_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate   Candidate      @relation(fields: [candidateId], references: [id])
  requisition JobRequisition @relation(fields: [requisitionId], references: [id])

  onboardingWorkflow OnboardingWorkflow?

  @@index([candidateId])
  @@index([status])
  @@map("job_offers")
}

// ============================================================================
// RECRUITMENT: ONBOARDING
// ============================================================================

model OnboardingWorkflow {
  id             String    @id @default(uuid())
  employeeId     String    @map("employee_id")
  workflowName   String    @map("workflow_name")
  startDate      DateTime  @map("start_date")
  targetEndDate  DateTime? @map("target_end_date")
  actualEndDate  DateTime? @map("actual_end_date")
  status         String    @default("not_started") // not_started, in_progress, blocked, completed, cancelled
  progress       Int       @default(0) // 0-100
  assignedTo     String?   @map("assigned_to")
  notes          String?   @db.Text
  country        Country?
  legalEntityId  String?   @map("legal_entity_id")
  sourceOfferId       String? @unique @map("source_offer_id")
  sourceCandidateId   String? @map("source_candidate_id")
  sourceRequisitionId String? @map("source_requisition_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee    Employee           @relation(fields: [employeeId], references: [id])
  sourceOffer JobOffer?          @relation(fields: [sourceOfferId], references: [id], onDelete: SetNull)
  tasks       OnboardingTask[]
  documents   OnboardingDocument[]

  @@index([employeeId])
  @@index([status])
  @@map("onboarding_workflows")
}

model OnboardingTask {
  id           String    @id @default(uuid())
  workflowId   String    @map("workflow_id")
  taskName     String    @map("task_name")
  description  String?   @db.Text
  category     String?   // documentation, training, equipment, access, etc.
  assignedTo   String?   @map("assigned_to")
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  completedBy  String?   @map("completed_by")
  status       String    @default("pending") // pending, in_progress, completed, skipped
  priority     Int       @default(5) // 1-10
  dependencies Json?     // array of task IDs this depends on
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workflow OnboardingWorkflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@index([status])
  @@map("onboarding_tasks")
}

model OnboardingDocument {
  id           String    @id @default(uuid())
  workflowId   String    @map("workflow_id")
  documentName String    @map("document_name")
  documentType String    @map("document_type")
  required     Boolean   @default(true)
  fileUrl      String?   @map("file_url")
  uploadedAt   DateTime? @map("uploaded_at")
  uploadedBy   String?   @map("uploaded_by")
  verifiedAt   DateTime? @map("verified_at")
  verifiedBy   String?   @map("verified_by")
  status       String    @default("pending") // pending, uploaded, verified, rejected
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  workflow OnboardingWorkflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@map("onboarding_documents")
}

// ============================================================================
// TIME & ATTENDANCE
// ============================================================================

model Shift {
  id                   String   @id @default(uuid())
  shiftName            String   @map("shift_name")
  shiftCode            String?  @unique @map("shift_code")
  startTime            String   @map("start_time") // HH:MM format
  endTime              String   @map("end_time")
  breakDurationMinutes Int      @default(0) @map("break_duration_minutes")
  breakPaid            Boolean  @default(false) @map("break_paid")
  shiftType            String   @default("regular") @map("shift_type") // regular, night, weekend
  totalHours           Decimal? @map("total_hours") @db.Decimal(5, 2)
  overtimeMultiplier   Decimal  @default(1.5) @map("overtime_multiplier") @db.Decimal(3, 2)
  lateGracePeriod      Int      @default(0) @map("late_grace_period") // minutes
  isActive             Boolean  @default(true) @map("is_active")
  country              Country?
  legalEntityId        String?  @map("legal_entity_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  assignments       ShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@index([shiftType])
  @@map("shifts")
}

model ShiftAssignment {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  shiftId       String    @map("shift_id")
  workDate      DateTime? @map("work_date")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  workDays      Json?     @map("work_days") // array of day numbers [1,2,3,4,5]
  status        String    @default("active") // active, inactive
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee          Employee           @relation(fields: [employeeId], references: [id])
  shift             Shift              @relation(fields: [shiftId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([employeeId, effectiveFrom])
  @@map("shift_assignments")
}

model AttendanceRecord {
  id                    String    @id @default(uuid())
  employeeId            String    @map("employee_id")
  shiftId               String?   @map("shift_id")
  shiftAssignmentId     String?   @map("shift_assignment_id")
  attendanceDate        DateTime? @map("attendance_date")
  workDate              DateTime? @map("work_date")
  clockInTime           DateTime? @map("clock_in_time")
  clockOutTime          DateTime? @map("clock_out_time")
  clockInLocation       String?   @map("clock_in_location")
  clockOutLocation      String?   @map("clock_out_location")
  clockInIp             String?   @map("clock_in_ip")
  clockOutIp            String?   @map("clock_out_ip")
  clockInLatitude       Decimal?  @map("clock_in_latitude") @db.Decimal(10, 8)
  clockInLongitude      Decimal?  @map("clock_in_longitude") @db.Decimal(11, 8)
  clockInAccuracy       Decimal?  @map("clock_in_accuracy") @db.Decimal(10, 2)
  clockOutLatitude      Decimal?  @map("clock_out_latitude") @db.Decimal(10, 8)
  clockOutLongitude     Decimal?  @map("clock_out_longitude") @db.Decimal(11, 8)
  clockOutAccuracy      Decimal?  @map("clock_out_accuracy") @db.Decimal(10, 2)
  clockInDeviceId       String?   @map("clock_in_device_id")
  clockOutDeviceId      String?   @map("clock_out_device_id")
  totalHours            Decimal?  @map("total_hours") @db.Decimal(5, 2)
  regularHours          Decimal?  @map("regular_hours") @db.Decimal(5, 2)
  overtimeHours         Decimal?  @map("overtime_hours") @db.Decimal(5, 2)
  hoursWorked           Decimal?  @map("hours_worked") @db.Decimal(5, 2)
  minutesLate           Int       @default(0) @map("minutes_late")
  lateByMinutes         Int       @default(0) @map("late_by_minutes")
  earlyDepartureMinutes Int       @default(0) @map("early_departure_minutes")
  status                String    @default("present") // present, absent, late, half_day, holiday
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  employee        Employee         @relation(fields: [employeeId], references: [id])
  shift           Shift?           @relation(fields: [shiftId], references: [id])
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id])
  clockEvents     ClockEvent[]

  @@index([employeeId, attendanceDate])
  @@index([workDate])
  @@map("attendance_records")
}

model ClockEvent {
  id                 String   @id @default(uuid())
  employeeId         String   @map("employee_id")
  attendanceRecordId String?  @map("attendance_record_id")
  eventType          String   @map("event_type") // clock_in, clock_out, break_start, break_end
  eventTime          DateTime @map("event_time")
  latitude           Decimal? @db.Decimal(10, 8)
