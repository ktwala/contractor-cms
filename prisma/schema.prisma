enum PayrunExceptionType {
  MISSING_BANK_DETAILS
  MISSING_TAX_NUMBER
  MISSING_PAY_INPUT
  NEGATIVE_NET_PAY
  ZERO_NET_PAY_UNEXPECTED
  INVALID_DEDUCTION_TOTAL
  OVERTIME_THRESHOLD_BREACH
  INACTIVE_EMPLOYEE_INCLUDED
  TERMINATED_EMPLOYEE_INCLUDED
  DUPLICATE_EMPLOYEE_IN_RUN
  MISSING_EMPLOYMENT_ASSIGNMENT
  MISSING_PAY_GROUP_MAPPING
  CALCULATION_ANOMALY
  UNUSUAL_VARIANCE
  PAYMENT_DATE_MISMATCH
  RUN_CONFIGURATION_WARNING
  MISSING_TAX_PROFILE
  MISSING_BANK_VERIFICATION
  MISSING_IDENTIFICATION
  ON_LEAVE_EMPLOYEE_INCLUDED
  DEDUCTIONS_EXCEED_GROSS
}

enum PayrunExceptionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PayrunExceptionStatus {
  OPEN
  ASSIGNED
  RESOLVED
  DISMISSED
}

enum PayrunExceptionResolutionType {
  DATA_FIXED
  ACCEPTED_WITH_JUSTIFICATION
  NOT_APPLICABLE
  MANUAL_OVERRIDE_APPROVED
}

enum DetectedByType {
  SYSTEM
  USER
  RULE_ENGINE
}

model PayrunException {
  id                  String                          @id @default(uuid())
  payrunId            String                          @map("payrun_id")
  employeeId          String?                         @map("employee_id")
  code                String
  type                PayrunExceptionType
  severity            PayrunExceptionSeverity
  status              PayrunExceptionStatus            @default(OPEN)
  title               String
  description         String
  detectedAt          DateTime                         @default(now()) @map("detected_at")
  detectedByType      DetectedByType                   @default(SYSTEM) @map("detected_by_type")

  ownerUserId         String?                          @map("owner_user_id")
  blocksSubmission    Boolean                          @default(false) @map("blocks_submission")
  blocksPayment       Boolean                          @default(false) @map("blocks_payment")

  resolutionType      PayrunExceptionResolutionType?   @map("resolution_type")
  resolutionNote      String?                          @map("resolution_note")
  resolvedByUserId    String?                          @map("resolved_by_user_id")
  resolvedAt          DateTime?                        @map("resolved_at")

  dismissedByUserId   String?                          @map("dismissed_by_user_id")
  dismissedAt         DateTime?                        @map("dismissed_at")
  dismissalReason     String?                          @map("dismissal_reason")

  metadataJson        Json?                            @map("metadata_json")

  createdAt           DateTime                         @default(now()) @map("created_at")
  updatedAt           DateTime                         @updatedAt @map("updated_at")

  payrun              PayRun                           @relation("PayrunExceptions", fields: [payrunId], references: [id], onDelete: Cascade)
  employee            Employee?                        @relation("PayrunExceptionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([payrunId, status])
  @@index([payrunId, severity, status])
  @@index([employeeId, status])
  @@index([ownerUserId, status])
  @@index([type, status])
  @@index([blocksSubmission, status])
  @@index([blocksPayment, status])
  @@map("payrun_exceptions")
}

