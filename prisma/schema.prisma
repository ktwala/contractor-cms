// Payroll Platform - Database Schema
// Supports: Lesotho (LS) + South Africa (ZA)
// Features: Effective-dated records, maker-checker approvals, audit trails

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts for Prisma 7
}

// ============================================================================
// ENUMS
// ============================================================================

enum Country {
  LS
  ZA
}

enum Currency {
  LSL
  ZAR
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  ON_LEAVE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  CASUAL
}

enum PositionStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum PayItemType {
  EARNING
  DEDUCTION
  TAX
  EMPLOYER_CONTRIB
}

enum PayrunFinancialControlStatus {
  MATCH
  VARIANCE
  BLOCKED
}

enum PayrunBankReconciliationStatus {
  MATCH
  VARIANCE
  REJECTED
  PARTIAL
  BLOCKED
}

enum PayrunBankConfirmationSourceType {
  BANK_ACK
  BANK_RETURN
  MANUAL
}

enum PayrunGLReconciliationStatus {
  MATCH
  VARIANCE
  BLOCKED
}

enum PayrunGLConfirmationSourceType {
  ERP_IMPORT
  GL_FILE
  MANUAL
}

enum PayRunStatus {
  DRAFT
  SNAPSHOT
  CALCULATING
  CALCULATED
  IN_REVIEW
  APPROVED
  PAID
  POSTED
  FINALIZED
  CANCELLED
}

enum PayRunType {
  REGULAR
  ADJUSTMENT
}

/// PR-PAYROLL-CONTAINER-1 — tax-year governance shell (does not replace PayGroup workforce scope).
enum PayrollTaxYearStatus {
  PLANNING
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AdjustmentMode {
  DELTA_ONLY
  FULL_RECALC
}

/// GOV-3D-2 — governed post-close reversal path.
enum PayrunReversalWorkflowStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

/// GOV-3D-2 — governed correction → adjustment path.
enum PayrunCorrectionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

/// PR-PAYRUN-GOV-6A — governance policy registry (thresholds / rules of governance).
enum GovernancePolicyScope {
  GLOBAL
  LEGAL_ENTITY
  PAY_GROUP
}

/// GOV-7B — policy change approval workflow (draft → approve → activate).
enum GovernancePolicyDraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVATED
  CANCELLED
}

enum ChangeRequestKind {
  EMPLOYEE_BANK_ACCOUNT
  EMPLOYEE_COMPENSATION
  EMPLOYEE_TAX_PROFILE
  PAY_ITEM_MAPPING
  OTHER
}

enum ChangeRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobKind {
  PAYRUN_CALCULATE
  IMPORT_VARIABLE_PAY
  IMPORT_TAX_TABLES
  EXPORT_BANK_FILE
  EXPORT_PAYSLIPS
  EXPORT_GL_JOURNAL
  EXPORT_STATUTORY
}

enum ImportKind {
  VARIABLE_PAY
  TAX_TABLES
}

enum ArtifactKind {
  BANK_FILE
  PAYSLIP_BUNDLE
  GL_JOURNAL
  STATUTORY_EXPORT
}

enum PackStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum TaxTableType {
  PAYE
  UIF
  SDL
  MTC
  ETI
}

enum ResidencyStatus {
  RESIDENT
  NON_RESIDENT
}

enum AccountType {
  CHEQUE
  SAVINGS
  CURRENT
}

enum RoundingMode {
  HALF_UP
  HALF_EVEN
  DOWN
  UP
}

enum RoleName {
  PAYROLL_MANAGER
  APPROVER
  HR_ADMIN
  // Canonical roles (RBAC Step 2)
  TENANT_ADMIN
  PAYROLL_CLERK
  PAYROLL_APPROVER
  FINANCE_APPROVER
  SARS_OFFICER
  SARS_APPROVER
  AUDITOR
  AUDITOR_READONLY
  EMPLOYEE_SELF_SERVICE
  INTEGRATION_IGA
  PLATFORM_SUPERADMIN
  // Payroll Run Center roles (RBAC Step 3)
  PAYROLL_PROCESSOR
  PAYMENT_OPERATOR
  RECONCILIATION_ANALYST
  FINANCE_REVIEWER
  COMPLIANCE_OFFICER
  TAX_TABLE_ADMINISTRATOR
  EXECUTIVE_READONLY
  GLOBAL_PAYROLL_ADMIN
  GLOBAL_COMPLIANCE_ADMIN
  // Talent / recruitment (aligned with prisma/seed.ts ROLES)
  TALENT_ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  HR_OPERATIONS
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  DELEGATED
}

enum ApprovalEntityType {
  PAYRUN
  CHANGE_REQUEST
  EMPLOYEE_CHANGE
}

enum RoleScopeType {
  GLOBAL
  LEGAL_ENTITY
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  userRoles         UserRole[]
  roleAssignments   RoleAssignment[]
  legalEntityAccess UserLegalEntityAccess[]
  auditLogs         AuditLog[]

  // Approval relations
  approvalLevelsAsApprover ApprovalLevel[]      @relation("ApprovalLevelApprover")
  submittedApprovals       ApprovalInstance[]   @relation("ApprovalSubmitter")
  assignedApprovalSteps    ApprovalStep[]       @relation("ApprovalStepAssigned")
  delegatedApprovalSteps   ApprovalStep[]       @relation("ApprovalStepDelegated")
  actedApprovalSteps       ApprovalStep[]       @relation("ApprovalStepActor")
  delegationsFrom          ApprovalDelegation[] @relation("DelegationFrom")
  delegationsTo            ApprovalDelegation[] @relation("DelegationTo")

  // Notification relations
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]

  // Self-service relation
  employee                 Employee?

  // Payroll Cycle relations
  payrollReconciliations   PayrollReconciliation[]
  checklistTasksAssigned   PayrollChecklistTask[] @relation("ChecklistTaskAssigned")
  checklistTasksCompleted  PayrollChecklistTask[] @relation("ChecklistTaskCompleted")

  bulkRemediations         WorkforceBulkRemediation[]

  remediationApprovalRequests  WorkforceRemediationApproval[] @relation("RemediationApprovalRequester")
  remediationApprovalDecisions WorkforceRemediationApproval[] @relation("RemediationApprovalApprover")

  governancePolicyDraftsRequested PayrollGovernancePolicyDraft[] @relation("GovernancePolicyDraftRequester")
  governancePolicyDraftsApproved   PayrollGovernancePolicyDraft[] @relation("GovernancePolicyDraftApprover")

  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        RoleName  @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  userRoles       UserRole[]
  roleAssignments RoleAssignment[]
  permissions    RolePermission[]
  approvalLevels ApprovalLevel[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserLegalEntityAccess {
  userId        String   @map("user_id")
  legalEntityId String   @map("legal_entity_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@id([userId, legalEntityId])
  @@map("user_legal_entity_access")
}

model RoleAssignment {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  roleId         String        @map("role_id")
  scopeType      RoleScopeType @default(LEGAL_ENTITY) @map("scope_type")
  legalEntityId  String?       @map("legal_entity_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  legalEntity  LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([legalEntityId])
  @@unique([userId, roleId, scopeType, legalEntityId])
  @@map("role_assignments")
}

// ============================================================================
// LEGAL ENTITIES
// ============================================================================

model LegalEntity {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  country        Country
  registrationNo String?  @map("registration_no")
  taxReference   String?  @map("tax_reference")
  address        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  payGroups            PayGroup[]
  employments          Employment[]
  orgUnits             OrgUnit[]
  changeRequests       ChangeRequest[]
  userAccess           UserLegalEntityAccess[]
  roleAssignments      RoleAssignment[]
  emp201Returns         EMP201Return[]
  emp501Reconciliations EMP501Reconciliation[]
  irp5Certificates      IRP5Certificate[]
  sarsSubmissions       SarsSubmission[]
  sarsSubmissionQueue   SarsSubmissionQueue[]
  approvalWorkflows     ApprovalWorkflow[]
  webhooks          Webhook[]
  payrollForecasts  PayrollForecast[]
  uifDeclarations   UIFDeclaration[]
  sdlDeclarations   SDLDeclaration[]
  coidaAssessments  COIDAAssessment[]
  jobRequisitions   JobRequisition[]
  positions         Position[]
  workLocations     WorkLocation[]
  payrollGovernancePolicies PayrollGovernancePolicy[]
  payrollGovernancePolicyDrafts PayrollGovernancePolicyDraft[]

  @@map("legal_entities")
}

/// Office / site master for recruitment (requisition location picker).
model WorkLocation {
  id            String   @id @default(uuid())
  legalEntityId String   @map("legal_entity_id")
  code          String   @map("code")
  name          String   @map("name")
  city          String?  @map("city")
  countryCode   String?  @map("country_code")
  isRemote      Boolean  @default(false) @map("is_remote")
  isHybrid      Boolean  @default(false) @map("is_hybrid")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  legalEntity     LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  jobRequisitions JobRequisition[]

  @@unique([legalEntityId, code])
  @@index([legalEntityId])
  @@map("work_locations")
}

model OrgUnit {
  id                            String                  @id @default(uuid())
  legalEntityId                 String                  @map("legal_entity_id")
  code                          String                  @map("code")
  name                          String                  @map("name")
  parentOrgUnitId               String?                 @map("parent_org_unit_id")
  managerEmployeeId             String?                 @map("manager_employee_id")
  managerAssignmentSource       ManagerAssignmentSource? @map("manager_assignment_source")
  managerAssignmentConfidence   Int?                    @map("manager_assignment_confidence")
  managerAssignmentUpdatedAt    DateTime?               @map("manager_assignment_updated_at")
  managerAssignmentUpdatedByUserId String?              @map("manager_assignment_updated_by_user_id")
  sortOrder                     Int                     @default(0) @map("sort_order")
  isActive                      Boolean                 @default(true) @map("is_active")
  createdAt                     DateTime                @default(now()) @map("created_at")
  updatedAt                     DateTime                @updatedAt @map("updated_at")

  legalEntity     LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  parentOrgUnit   OrgUnit?      @relation("OrgUnitHierarchy", fields: [parentOrgUnitId], references: [id])
  childOrgUnits   OrgUnit[]     @relation("OrgUnitHierarchy")
  employmentAssignments EmploymentAssignment[]
  positions       Position[]
  managerSuggestions OrgUnitManagerSuggestion[]

  @@unique([legalEntityId, code])
  @@index([legalEntityId])
  @@index([parentOrgUnitId])
  @@map("org_units")
}

model Position {
  id                  String         @id @default(uuid())
  legalEntityId       String         @map("legal_entity_id")
  orgUnitId           String         @map("org_unit_id")
  positionCode        String         @map("position_code")
  title               String
  status              PositionStatus @default(ACTIVE)
  defaultCostCenterId String?        @map("default_cost_center_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  legalEntity    LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  orgUnit        OrgUnit        @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  defaultCostCenter CostCenter? @relation(fields: [defaultCostCenterId], references: [id], onDelete: SetNull)
  assignments   EmploymentAssignment[]

  @@unique([legalEntityId, positionCode])
  @@index([orgUnitId])
  @@index([legalEntityId])
  @@index([status])
  @@map("positions")
}

// ============================================================================
// PAY GROUPS & PERIODS
// ============================================================================

model PayGroup {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  country         Country
  currency        Currency
  frequency       PayFrequency
  legalEntityId   String       @map("legal_entity_id")
  defaultCalendar Json?        @map("default_calendar")
  glDefaults      Json?        @map("gl_defaults")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  legalEntity       LegalEntity        @relation(fields: [legalEntityId], references: [id])
  payPeriods        PayPeriod[]
  payrolls          Payroll[]
  payRuns           PayRun[]
  employments       Employment[]
  payItems          PayItem[]
  approvalWorkflows ApprovalWorkflow[]
  payrollGovernancePolicies PayrollGovernancePolicy[]
  payrollGovernancePolicyDrafts PayrollGovernancePolicyDraft[]

  @@map("pay_groups")
}

/// PR-PAYROLL-CONTAINER-1 — statutory / tax-year governance container; references PayGroup (workforce scope unchanged).
model Payroll {
  id             String               @id @default(uuid())
  payGroupId     String               @map("pay_group_id")
  label          String
  taxYearStart   DateTime             @map("tax_year_start") @db.Date
  taxYearEnd     DateTime             @map("tax_year_end") @db.Date
  status         PayrollTaxYearStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  payGroup   PayGroup    @relation(fields: [payGroupId], references: [id], onDelete: Restrict)
  payPeriods PayPeriod[]

  @@unique([payGroupId, taxYearStart, taxYearEnd], map: "payrolls_pay_group_tax_year_window_key")
  @@index([payGroupId])
  @@map("payrolls")
}

/// PR-PAYRUN-GOV-6A — versioned registry for governance thresholds and policy knobs (effective-dated chain).
model PayrollGovernancePolicy {
  id                     String                  @id @default(uuid())
  policyKey              String                  @map("policy_key")
  scope                  GovernancePolicyScope
  legalEntityId          String?                 @map("legal_entity_id")
  payGroupId             String?                 @map("pay_group_id")
  currentValue           Json                    @map("current_value")
  effectiveFrom          DateTime                @map("effective_from")
  changedByUserId        String                  @map("changed_by_user_id")
  approvalReference      String?                 @map("approval_reference")
  supersededByPolicyId   String?                 @map("superseded_by_policy_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  legalEntity          LegalEntity?             @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  payGroup             PayGroup?                @relation(fields: [payGroupId], references: [id], onDelete: Cascade)
  supersededByPolicy   PayrollGovernancePolicy? @relation("GovernancePolicySupersedes", fields: [supersededByPolicyId], references: [id], onDelete: SetNull)
  supersedesPriorRows  PayrollGovernancePolicy[] @relation("GovernancePolicySupersedes")
  activatedFromDraft   PayrollGovernancePolicyDraft?

  @@index([policyKey, scope, legalEntityId, payGroupId])
  @@index([legalEntityId])
  @@index([payGroupId])
  @@index([supersededByPolicyId])
  @@map("payroll_governance_policies")
}

/// GOV-7B — pending governance policy change (replaces direct POST …/governance-policies activation).
model PayrollGovernancePolicyDraft {
  id                  String                      @id @default(uuid())
  policyKey           String                      @map("policy_key")
  scope               GovernancePolicyScope
  legalEntityId       String?                     @map("legal_entity_id")
  payGroupId          String?                     @map("pay_group_id")
  proposedValue       Json                        @map("proposed_value")
  effectiveFrom       DateTime                    @map("effective_from")
  impactPreviewHash   String                      @map("impact_preview_hash")
  requestedByUserId   String                      @map("requested_by_user_id")
  approvedByUserId    String?                     @map("approved_by_user_id")
  approvedAt          DateTime?                   @map("approved_at")
  status              GovernancePolicyDraftStatus
  activationPolicyId  String?                     @unique @map("activation_policy_id")
  approvalReference   String                      @map("approval_reference")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  requestedByUser User                 @relation("GovernancePolicyDraftRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUser  User?                @relation("GovernancePolicyDraftApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  legalEntity     LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  payGroup        PayGroup?            @relation(fields: [payGroupId], references: [id], onDelete: Cascade)
  activatedPolicy PayrollGovernancePolicy? @relation(fields: [activationPolicyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([policyKey, scope, legalEntityId, payGroupId])
  @@index([requestedByUserId])
  @@map("payroll_governance_policy_drafts")
}

model PayPeriod {
  id         String    @id @default(uuid())
  payGroupId String    @map("pay_group_id")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  payDate    DateTime  @map("pay_date") @db.Date
  cutoffDate DateTime? @map("cutoff_date") @db.Date
  year       Int
  periodNum  Int       @map("period_num")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// PR-PAYRUN-GOV-3D-1: set when payroll period close succeeds (governance gate + calendar close).
  closedAt        DateTime? @map("closed_at")
  closedByUserId  String?   @map("closed_by_user_id")
  /// PR-PAYROLL-CONTAINER-1 — optional link to tax-year payroll shell (backfilled in later PR).
  payrollId       String?   @map("payroll_id")

  payGroup                    PayGroup                @relation(fields: [payGroupId], references: [id])
  payroll                     Payroll?                @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  payRuns                     PayRun[]
  reconciliations             PayrollReconciliation[] @relation("ReconciliationPeriod")
  reconciliationComparisons   PayrollReconciliation[] @relation("ReconciliationComparison")
  exceptions                  PayrollException[]
  checklists                  PayrollChecklist[]

  @@unique([payGroupId, year, periodNum])
  @@index([payrollId])
  @@map("pay_periods")
}

// ============================================================================
// EMPLOYEES & EFFECTIVE-DATED RECORDS
// ============================================================================

model Employee {
  id              String         @id @default(uuid())
  employeeNo      String         @unique @map("employee_no")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  nationalId      String?        @map("national_id")
  email           String?
  phone           String?
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  idType          String?        @map("id_type")
  idNumber        String?        @map("id_number")
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime       @map("hire_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  userId          String?        @unique @map("user_id")
  salary          Decimal?       @db.Decimal(15, 2)
  department      String?
  jobTitle        String?        @map("job_title")
  managerId       String?        @map("manager_id")
  hierarchyRole   HierarchyRole  @default(NORMAL) @map("hierarchy_role")
  profilePictureUrl String?      @map("profile_picture_url")
  country         Country?
  legalEntityId   String?        @map("legal_entity_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user               User?              @relation(fields: [userId], references: [id])
  manager            Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]         @relation("EmployeeManager")
  employments        Employment[]
  compensations      Compensation[]
  bankAccounts       BankAccount[]
  taxProfiles        TaxProfile[]
  payRunEmployees    PayRunEmployee[]
  lineItemInputs     LineItemInput[]
  recurringInputs    RecurringInput[]
  employeeResults    EmployeeResult[]
  changeRequests     ChangeRequest[]
  taxCertificates    TaxCertificate[]
  payrollExceptions      PayrollException[]
  payrunExceptionsRef    PayrunException[]    @relation("PayrunExceptionEmployee")
  employeeBenefits       EmployeeBenefit[]

  // Leave Management
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  leaveAccruals      LeaveAccrual[]

  // Document Management
  documents          Document[]
  employeeDocuments  EmployeeDocument[]

  // Time & Attendance
  shiftAssignments   ShiftAssignment[]
  attendanceRecords  AttendanceRecord[]
  clockEvents        ClockEvent[]
  overtimeRequests   OvertimeRequest[]

  // Performance
  performanceGoalsAsEmployee PerformanceGoal[]   @relation("EmployeeGoals")
  performanceGoalsAsManager  PerformanceGoal[]   @relation("ManagerGoals")
  performanceReviewsAsEmployee PerformanceReview[] @relation("EmployeeReviews")
  performanceReviewsAsManager  PerformanceReview[] @relation("ManagerReviews")
  feedbackReceived   PerformanceFeedback[]       @relation("FeedbackForEmployee")
  feedbackProvided   PerformanceFeedback[]       @relation("FeedbackByEmployee")

  // Recruiting / Onboarding
  onboardingWorkflows OnboardingWorkflow[]

  // Expenses & Loans
  expenseClaims      ExpenseClaim[]
  loanApplications   LoanApplication[]

  // Payslips
  paySlips           PaySlip[]

  // SARS
  irp5Certificates   IRP5Certificate[]

  // Payroll Opening Balances
  payrollOpeningBalances EmployeePayrollOpeningBalance[]
  leaveOpeningBalances   EmployeeLeaveOpeningBalance[]
  loanOpeningBalances    EmployeeLoanOpeningBalance[]

  @@map("employees")
}

model Employment {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  legalEntityId  String         @map("legal_entity_id")
  payGroupId     String         @map("pay_group_id")
  country        Country
  jobTitle       String?        @map("job_title")
  costCenter     String?        @map("cost_center")
  employmentType EmploymentType @default(PERMANENT) @map("employment_type")
  effectiveFrom  DateTime       @map("effective_from") @db.Date
  effectiveTo    DateTime?      @map("effective_to") @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee    Employee    @relation(fields: [employeeId], references: [id])
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  payGroup    PayGroup    @relation(fields: [payGroupId], references: [id])
  employmentAssignments EmploymentAssignment[]

  @@index([employeeId, effectiveFrom])
  @@index([updatedAt])
  @@map("employments")
}

model EmploymentAssignment {
  id             String    @id @default(uuid())
  employmentId   String    @map("employment_id")
  orgUnitId      String    @map("org_unit_id")
  costCenterId   String?   @map("cost_center_id")
  positionId     String?   @map("position_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employment  Employment  @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  costCenter  CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  position    Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([employmentId, effectiveFrom])
  @@index([orgUnitId])
  @@index([positionId])
  @@map("employment_assignments")
}

model Compensation {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  baseSalary    Decimal   @map("base_salary") @db.Decimal(18, 2)
  currency      Currency
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("compensations")
}

model BankAccount {
  id                  String      @id @default(uuid())
  employeeId          String      @map("employee_id")
  bankName            String      @map("bank_name")
  accountNumberEnc    String      @map("account_number_enc")
  maskedAccountNumber String      @map("masked_account_number")
  branchCode          String?     @map("branch_code")
  accountType         AccountType? @map("account_type")
  effectiveFrom       DateTime    @map("effective_from") @db.Date
  effectiveTo         DateTime?   @map("effective_to") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("bank_accounts")
}

model TaxProfile {
  id              String          @id @default(uuid())
  employeeId      String          @map("employee_id")
  country         Country
  residencyStatus ResidencyStatus @map("residency_status")
  tin             String?
  effectiveFrom   DateTime        @map("effective_from") @db.Date
  effectiveTo     DateTime?       @map("effective_to") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("tax_profiles")
}

// ============================================================================
// PAY ITEMS & RULES
// ============================================================================

model PayItem {
  id                String      @id @default(uuid())
  code              String      @unique
  name              String
  description       String?
  type              PayItemType
  category          String?     // e.g., "STATUTORY", "BENEFIT", "ALLOWANCE"
  taxable           Boolean     @default(true)
  glAccount         String?     @map("gl_account")
  glAccountCredit   String?     @map("gl_account_credit")
  sortOrder         Int         @default(100) @map("sort_order")
  formula           String?     // e.g., "BASIC * 0.01" for UIF calculation
  formulaDeps       String[]    @default([]) @map("formula_deps") // ["BASIC"]
  countryAttributes Json?       @map("country_attributes")
  isActive          Boolean     @default(true) @map("is_active")
  isSystem          Boolean     @default(false) @map("is_system") // Cannot be deleted
  payGroupId        String?     @map("pay_group_id") // null = global
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  payGroup        PayGroup?       @relation(fields: [payGroupId], references: [id])
  lineItemInputs  LineItemInput[]
  recurringInputs RecurringInput[]
  payLines        PayLine[]

  @@index([payGroupId, isActive])
  @@index([type, isActive])
  @@map("pay_items")
}

model Rule {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  country       Country?
  expression    String
  dependencies  String[]
  rounding      Json?
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([country, effectiveFrom])
  @@map("rules")
}

// ============================================================================
// PACK REGISTRY (versioned compute packs)
// ============================================================================

model PackRegistry {
  id               String     @id @default(uuid())
  country          Country
  packVersion      String     @map("pack_version")
  displayName      String?    @map("display_name")
  description      String?
  effectiveFrom    DateTime   @map("effective_from") @db.Date
  effectiveTo      DateTime?  @map("effective_to") @db.Date
  status           PackStatus @default(DRAFT)
  artifactChecksum String?    @map("artifact_checksum")
  releaseNotes     String?    @map("release_notes")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  createdBy        String?    @map("created_by")

  @@unique([country, packVersion])
  @@index([country, status, effectiveFrom])
  @@map("pack_registry")
}

// ============================================================================
// TAX TABLE SETS (versioned, checksummed tax data)
// ============================================================================

model TaxTableSet {
  id            String       @id @default(uuid())
  country       Country
  tableType     TaxTableType @map("table_type")
  taxYear       String       @map("tax_year")
  displayName   String?      @map("display_name")
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  status        PackStatus   @default(DRAFT)
  sourceRef     String?      @map("source_ref")
  checksum      String
  data          Json
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  createdBy     String?      @map("created_by")

  @@unique([country, tableType, taxYear])
  @@index([country, tableType, status, effectiveFrom])
  @@map("tax_table_sets")
}

// ============================================================================
// STATUTORY CONFIGS (UIF ceilings, SDL thresholds, etc.)
// ============================================================================

model StatutoryConfig {
  id            String     @id @default(uuid())
  country       Country
  configType    String     @map("config_type")
  effectiveFrom DateTime   @map("effective_from") @db.Date
  effectiveTo   DateTime?  @map("effective_to") @db.Date
  status        PackStatus @default(DRAFT)
  checksum      String?
  data          Json
  sourceRef     String?    @map("source_ref")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([country, configType, effectiveFrom])
  @@index([country, configType, status])
  @@map("statutory_configs")
}

// ============================================================================
// TAX TABLES (legacy - keeping for backward compatibility)
// ============================================================================

model TaxTable {
  id            String    @id @default(uuid())
  country       Country
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  meta          Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  brackets TaxBracket[]

  @@unique([country, effectiveFrom])
  @@map("tax_tables")
}

model TaxBracket {
  id         String   @id @default(uuid())
  taxTableId String   @map("tax_table_id")
  fromAmount Decimal  @map("from_amount") @db.Decimal(18, 2)
  toAmount   Decimal? @map("to_amount") @db.Decimal(18, 2)
  rate       Decimal  @db.Decimal(10, 6)
  baseTax    Decimal? @map("base_tax") @db.Decimal(18, 2)
  sortOrder  Int      @default(0) @map("sort_order")

  taxTable TaxTable @relation(fields: [taxTableId], references: [id], onDelete: Cascade)

  @@index([taxTableId, sortOrder])
  @@map("tax_brackets")
}

// ============================================================================
// PAYRUNS
// ============================================================================

model PayRun {
  id               String          @id @default(uuid())
  payGroupId       String          @map("pay_group_id")
  periodId         String?         @map("period_id")
  periodStart      DateTime?       @map("period_start") @db.Date
  periodEnd        DateTime?       @map("period_end") @db.Date
  payDate          DateTime?       @map("pay_date") @db.Date
  status           PayRunStatus    @default(DRAFT)
  payrunType       PayRunType      @default(REGULAR) @map("payrun_type")
  basePayrunId     String?         @map("base_payrun_id")
  adjustmentReason String?         @map("adjustment_reason")
  adjustmentMode   AdjustmentMode? @map("adjustment_mode")
  notes            String?
  // SoD fields (PR-SOD-01, PR-SOD-02, PR-SOD-03)
  createdByUserId   String?       @map("created_by_user_id")
  submittedByUserId String?       @map("submitted_by_user_id")
  submittedAt       DateTime?     @map("submitted_at")
  approvedByUserId  String?       @map("approved_by_user_id")
  approvedAt        DateTime?     @map("approved_at")
  paidByUserId      String?       @map("paid_by_user_id")
  paidAt            DateTime?     @map("paid_at")
  postedByUserId    String?       @map("posted_by_user_id")
  postedAt          DateTime?     @map("posted_at")
  finalizedByUserId String?       @map("finalized_by_user_id")
  finalizedAt       DateTime?     @map("finalized_at")
  lockedAt         DateTime?       @map("locked_at")
  lastCalculatedAt DateTime?       @map("last_calculated_at")
  snapshotAt       DateTime?       @map("snapshot_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  /// GOV-4 — set when a governed reversal/correction links an adjustment; cleared via acknowledge API.
  financialControlImpacted   Boolean @default(false) @map("financial_control_impacted")
  bankReconciliationImpacted Boolean @default(false) @map("bank_reconciliation_impacted")
  glReconciliationImpacted   Boolean @default(false) @map("gl_reconciliation_impacted")

  payGroup        PayGroup           @relation(fields: [payGroupId], references: [id])
  period          PayPeriod?         @relation(fields: [periodId], references: [id])
  basePayrun      PayRun?            @relation("PayRunAdjustments", fields: [basePayrunId], references: [id])
  adjustments     PayRun[]           @relation("PayRunAdjustments")
  payRunEmployees PayRunEmployee[]
  lineItemInputs  LineItemInput[]
  employeeResults EmployeeResult[]
  imports         Import[]
  artifacts       Artifact[]
  jobs            Job[]
  context         PayRunContext?
  exceptions          PayrollException[]
  payrunExceptions    PayrunException[]    @relation("PayrunExceptions")
  paySlips            PaySlip[]
  paymentBatches      PaymentBatch[]
  payrunFinancialControl PayrunFinancialControl?
  payrunBankReconciliations PayrunBankReconciliation[]
  payrunGLReconciliation PayrunGLReconciliation?
  complianceReports   PayrollComplianceReport[] @relation("PayrunComplianceReports")
  payrunReversalWorkflowsAsSource      PayrunReversalWorkflow[]    @relation("PayrunReversalWorkflowSource")
  payrunReversalWorkflowAsReversalTarget PayrunReversalWorkflow?   @relation("PayrunReversalWorkflowReversalTarget")
  payrunCorrectionApprovalsForTarget   PayrunCorrectionApproval[] @relation("PayrunCorrectionApprovalPayrun")
  payrunCorrectionAsApprovedAdjustment PayrunCorrectionApproval?  @relation("PayrunCorrectionApprovalAdjustment")

  /// Uniqueness of (pay_group_id, period_id) for active REGULAR runs is enforced in PostgreSQL by a partial
  /// unique index (see migration `20260509140000_payruns_partial_unique_regular_period`) — not via @@unique here,
  /// so cancelled payruns can be replaced and ADJUSTMENT runs can share a calendar period with REGULAR.
  @@index([payGroupId, status])
  @@map("payruns")
}

model PayrunReversalWorkflow {
  id                  String                       @id @default(uuid())
  sourcePayrunId      String                       @map("source_payrun_id")
  reason              String
  initiatedByUserId   String                       @map("initiated_by_user_id")
  approvedByUserId    String?                      @map("approved_by_user_id")
  approvedAt          DateTime?                    @map("approved_at")
  status              PayrunReversalWorkflowStatus @default(PENDING_APPROVAL)
  reversalPayrunId    String?                      @unique @map("reversal_payrun_id")
  auditChain          Json?                        @map("audit_chain")
  downstreamReconciliationRequired Boolean        @default(false) @map("downstream_reconciliation_required")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  sourcePayrun   PayRun  @relation("PayrunReversalWorkflowSource", fields: [sourcePayrunId], references: [id], onDelete: Cascade)
  reversalPayrun PayRun? @relation("PayrunReversalWorkflowReversalTarget", fields: [reversalPayrunId], references: [id], onDelete: SetNull)

  @@index([sourcePayrunId, status])
  @@map("payrun_reversal_workflows")
}

model PayrunCorrectionApproval {
  id                           String                         @id @default(uuid())
  payrunId                     String                         @map("payrun_id")
  requestedChangeScope         String                         @map("requested_change_scope")
  requestedByUserId            String                         @map("requested_by_user_id")
  approverUserId               String?                        @map("approver_user_id")
  approvedAt                   DateTime?                      @map("approved_at")
  approvalReference            String                         @unique @map("approval_reference")
  resultingAdjustmentPayrunId String?                        @unique @map("resulting_adjustment_payrun_id")
  status                       PayrunCorrectionApprovalStatus @default(PENDING)
  downstreamReconciliationRequired Boolean                    @default(false) @map("downstream_reconciliation_required")
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @updatedAt @map("updated_at")

  payrun                     PayRun  @relation("PayrunCorrectionApprovalPayrun", fields: [payrunId], references: [id], onDelete: Cascade)
  resultingAdjustmentPayrun PayRun? @relation("PayrunCorrectionApprovalAdjustment", fields: [resultingAdjustmentPayrunId], references: [id], onDelete: SetNull)

  @@index([payrunId, status])
  @@map("payrun_correction_approvals")
}

model PayRunContext {
  id                String   @id @default(uuid())
  payrunId          String   @unique @map("payrun_id")
  country           Country
  currency          Currency
  legalEntityId     String   @map("legal_entity_id")
  packVersion       String   @map("pack_version")
  packRegistryId    String?  @map("pack_registry_id")
  taxTableSetId     String?  @map("tax_table_set_id")
  taxTable          Json     @map("tax_table")
  roundingPolicy    Json?    @map("rounding_policy")
  routingSnapshot   Json?    @map("routing_snapshot")
  checksums         Json?
  computeDateRule   String?  @map("compute_date_rule")
  computeDateValue  String?  @map("compute_date_value")
  createdAt         DateTime @default(now()) @map("created_at")

  payrun PayRun @relation(fields: [payrunId], references: [id], onDelete: Cascade)

  @@map("payrun_contexts")
}

model PayRunEmployee {
  id           String   @id @default(uuid())
  payrunId     String   @map("payrun_id")
  employeeId   String   @map("employee_id")
  included     Boolean  @default(true)
  excludeNote  String?  @map("exclude_note")
  snapshotData Json?    @map("snapshot_data")
  createdAt    DateTime @default(now()) @map("created_at")

  payrun   PayRun   @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([payrunId, employeeId])
  @@map("payrun_employees")
}

model LineItemInput {
  id         String   @id @default(uuid())
  payrunId   String   @map("payrun_id")
  employeeId String   @map("employee_id")
  payItemId  String   @map("pay_item_id")
  amount     Decimal  @db.Decimal(18, 2)
  currency   Currency
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  payrun   PayRun   @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  payItem  PayItem  @relation(fields: [payItemId], references: [id])

  @@index([payrunId, employeeId])
  @@map("line_item_inputs")
}

model RecurringInput {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  payItemId  String    @map("pay_item_id")
  amount     Decimal   @db.Decimal(18, 2)
  currency   Currency
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  meta       Json?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  payItem  PayItem  @relation(fields: [payItemId], references: [id])

  @@index([employeeId, isActive])
  @@index([payItemId])
  @@map("recurring_inputs")
}

model EmployeeResult {
  id              String   @id @default(uuid())
  payrunId        String   @map("payrun_id")
  employeeId      String   @map("employee_id")
  gross           Decimal  @db.Decimal(18, 2)
  taxableIncome   Decimal  @map("taxable_income") @db.Decimal(18, 2)
  paye            Decimal  @db.Decimal(18, 2)
  deductionsTotal Decimal  @map("deductions_total") @db.Decimal(18, 2)
  net             Decimal  @db.Decimal(18, 2)
  calculatedAt    DateTime @map("calculated_at")
  calcTrace       Json?    @map("calc_trace")
  createdAt       DateTime @default(now()) @map("created_at")

  payrun   PayRun    @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id])
  payLines PayLine[]

  @@unique([payrunId, employeeId])
  @@map("employee_results")
}

model PayLine {
  id               String      @id @default(uuid())
  employeeResultId String      @map("employee_result_id")
  payItemId        String      @map("pay_item_id")
  type             PayItemType
  amount           Decimal     @db.Decimal(18, 2)
  meta             Json?
  createdAt        DateTime    @default(now()) @map("created_at")

  employeeResult EmployeeResult @relation(fields: [employeeResultId], references: [id], onDelete: Cascade)
  payItem        PayItem        @relation(fields: [payItemId], references: [id])

  @@index([employeeResultId])
  @@map("pay_lines")
}

// ============================================================================
// CHANGE REQUESTS (MAKER-CHECKER)
// ============================================================================

model ChangeRequest {
  id                     String              @id @default(uuid())
  kind                   ChangeRequestKind
  status                 ChangeRequestStatus @default(SUBMITTED)
  subjectEntityType      String              @map("subject_entity_type")
  subjectEntityId        String              @map("subject_entity_id")
  country                Country?
  legalEntityId          String?             @map("legal_entity_id")
  requestedEffectiveFrom DateTime?           @map("requested_effective_from") @db.Date
  requestedEffectiveTo   DateTime?           @map("requested_effective_to") @db.Date
  reason                 String?
  payload                Json
  createdBy              String              @map("created_by")
  createdAt              DateTime            @default(now()) @map("created_at")
  reviewedBy             String?             @map("reviewed_by")
  reviewedAt             DateTime?           @map("reviewed_at")
  reviewComment          String?             @map("review_comment")
  appliedEntityType      String?             @map("applied_entity_type")
  appliedEntityId        String?             @map("applied_entity_id")

  employee    Employee?    @relation(fields: [subjectEntityId], references: [id])
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id])

  @@index([status, kind])
  @@index([subjectEntityId])
  @@map("change_requests")
}

// ============================================================================
// IMPORTS
// ============================================================================

model Import {
  id          String       @id @default(uuid())
  payrunId    String?      @map("payrun_id")
  kind        ImportKind
  status      JobStatus    @default(QUEUED)
  filename    String?
  summary     Json?
  errors      Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  payrun PayRun? @relation(fields: [payrunId], references: [id])

  @@index([payrunId])
  @@map("imports")
}

// ============================================================================
// ARTIFACTS
// ============================================================================

model Artifact {
  id             String       @id @default(uuid())
  payrunId       String       @map("payrun_id")
  kind           ArtifactKind
  filename       String?
  contentType    String?      @map("content_type")
  sizeBytes      Int?         @map("size_bytes")
  checksumSha256 String?      @map("checksum_sha256")
  storagePath    String?      @map("storage_path")
  createdAt      DateTime     @default(now()) @map("created_at")

  payrun PayRun @relation(fields: [payrunId], references: [id])

  @@index([payrunId])
  @@map("artifacts")
}

// ============================================================================
// JOBS
// ============================================================================

model Job {
  id          String    @id @default(uuid())
  kind        JobKind
  status      JobStatus @default(QUEUED)
  payrunId    String?   @map("payrun_id")
  artifactId  String?   @map("artifact_id")
  importId    String?   @map("import_id")
  errorCode   String?   @map("error_code")
  errorMessage String?  @map("error_message")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")

  payrun PayRun? @relation(fields: [payrunId], references: [id])

  @@index([status])
  @@map("jobs")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  reason       String?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// APPROVAL WORKFLOWS
// ============================================================================

model ApprovalWorkflow {
  id              String             @id @default(uuid())
  name            String
  description     String?
  entityType      ApprovalEntityType @map("entity_type")
  legalEntityId   String?            @map("legal_entity_id") // null = global
  payGroupId      String?            @map("pay_group_id") // null = all pay groups
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  legalEntity     LegalEntity?       @relation(fields: [legalEntityId], references: [id])
  payGroup        PayGroup?          @relation(fields: [payGroupId], references: [id])
  levels          ApprovalLevel[]
  instances       ApprovalInstance[]

  @@unique([entityType, legalEntityId, payGroupId])
  @@map("approval_workflows")
}

model ApprovalLevel {
  id              String           @id @default(uuid())
  workflowId      String           @map("workflow_id")
  levelOrder      Int              @map("level_order") // 1, 2, 3...
  name            String           // e.g., "Manager", "Payroll Admin", "Finance"
  description     String?
  approverUserId  String?          @map("approver_user_id") // Specific user
  approverRoleId  String?          @map("approver_role_id") // Or role-based
  canDelegate     Boolean          @default(true) @map("can_delegate")
  autoApproveAfterHours Int?       @map("auto_approve_after_hours") // null = no auto
  createdAt       DateTime         @default(now()) @map("created_at")

  workflow        ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser    User?            @relation("ApprovalLevelApprover", fields: [approverUserId], references: [id])
  approverRole    Role?            @relation(fields: [approverRoleId], references: [id])
  steps           ApprovalStep[]

  @@unique([workflowId, levelOrder])
  @@map("approval_levels")
}

model ApprovalInstance {
  id              String             @id @default(uuid())
  workflowId      String             @map("workflow_id")
  entityType      ApprovalEntityType @map("entity_type")
  entityId        String             @map("entity_id") // PayRun ID, ChangeRequest ID, etc.
  currentLevel    Int                @default(1) @map("current_level")
  isComplete      Boolean            @default(false) @map("is_complete")
  isCancelled     Boolean            @default(false) @map("is_cancelled")
  submittedBy     String             @map("submitted_by")
  submittedAt     DateTime           @default(now()) @map("submitted_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  workflow        ApprovalWorkflow   @relation(fields: [workflowId], references: [id])
  submitter       User               @relation("ApprovalSubmitter", fields: [submittedBy], references: [id])
  steps           ApprovalStep[]

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("approval_instances")
}

model ApprovalStep {
  id              String             @id @default(uuid())
  instanceId      String             @map("instance_id")
  levelId         String             @map("level_id")
  levelOrder      Int                @map("level_order")
  status          ApprovalStepStatus @default(PENDING)
  assignedTo      String             @map("assigned_to")
  delegatedTo     String?            @map("delegated_to")
  delegatedAt     DateTime?          @map("delegated_at")
  delegationNote  String?            @map("delegation_note")
  actedBy         String?            @map("acted_by")
  actedAt         DateTime?          @map("acted_at")
  comment         String?
  createdAt       DateTime           @default(now()) @map("created_at")

  instance        ApprovalInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  level           ApprovalLevel      @relation(fields: [levelId], references: [id])
  assignedUser    User               @relation("ApprovalStepAssigned", fields: [assignedTo], references: [id])
  delegatedUser   User?              @relation("ApprovalStepDelegated", fields: [delegatedTo], references: [id])
  actor           User?              @relation("ApprovalStepActor", fields: [actedBy], references: [id])

  @@unique([instanceId, levelOrder])
  @@index([assignedTo, status])
  @@map("approval_steps")
}

model ApprovalDelegation {
