model TaxCertificate {
  id                  String    @id @default(uuid())
  employeeId          String    @map("employee_id")
  taxYear             String    @map("tax_year")
  certificateType     String    @map("certificate_type") // IRP5, IT3(a), etc.
  certificateNumber   String?   @map("certificate_number")
  issueDate           DateTime  @map("issue_date")

  // Employment period
  employmentStart     DateTime  @map("employment_start") @db.Date
  employmentEnd       DateTime? @map("employment_end") @db.Date
  periodsWorked       Int       @default(0) @map("periods_worked")

  // Income
  grossRemuneration   Decimal   @default(0) @map("gross_remuneration") @db.Decimal(15, 2)
  grossNonTaxable     Decimal   @default(0) @map("gross_non_taxable") @db.Decimal(15, 2)
  taxableIncome       Decimal   @default(0) @map("taxable_income") @db.Decimal(15, 2)

  // Tax
  payeDeducted        Decimal   @default(0) @map("paye_deducted") @db.Decimal(15, 2)

  // Statutory deductions
  uifEmployee         Decimal   @default(0) @map("uif_employee") @db.Decimal(15, 2)
  pensionFund         Decimal?  @map("pension_fund") @db.Decimal(15, 2)
  retirementAnnuity   Decimal?  @map("retirement_annuity") @db.Decimal(15, 2)
  medicalAid          Decimal?  @map("medical_aid") @db.Decimal(15, 2)

  // Travel
  travelAllowance     Decimal?  @map("travel_allowance") @db.Decimal(15, 2)
  travelReimbursive   Decimal?  @map("travel_reimbursive") @db.Decimal(15, 2)

  // Totals
  otherDeductions     Decimal   @default(0) @map("other_deductions") @db.Decimal(15, 2)
  totalIncome         Decimal   @default(0) @map("total_income") @db.Decimal(15, 2)
  totalDeductions     Decimal   @default(0) @map("total_deductions") @db.Decimal(15, 2)

