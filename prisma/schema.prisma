// ============================================================================
// PAYMENT BATCHES
// ============================================================================

model PaymentBatch {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  payrunId              String?   @map("payrun_id")
  reference             String
  bankFileFormat        String    @map("bank_file_format")
  status                String    @default("PENDING")
  totalAmount           Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  paymentCount          Int       @default(0) @map("payment_count")
  countryCode           String?   @map("country_code")
  legalEntityId         String?   @map("legal_entity_id")
  payGroupId            String?   @map("pay_group_id")
  currencyCode          String    @default("ZAR") @map("currency_code")
  exportStatus          String    @default("NOT_GENERATED") @map("export_status")
  exportGeneratedAt     DateTime? @map("export_generated_at")
  exportedByUserId      String?   @map("exported_by_user_id")
  confirmedPaidAt       DateTime? @map("confirmed_paid_at")
  confirmedPaidByUserId String?   @map("confirmed_paid_by_user_id")
  confirmationNote      String?   @map("confirmation_note")
  generatedAt           DateTime? @map("generated_at")
  processedAt           DateTime? @map("processed_at")
  syncedAt              DateTime? @map("synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  payrun         PayRun?      @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  payments       Payment[]
  payrunFinancialControls PayrunFinancialControl[]
  payrunBankReconciliation PayrunBankReconciliation?

  @@index([organizationId, status])
  @@index([payrunId])
  @@index([status])
  @@index([exportStatus])
  @@map("payment_batches")
}

model Payment {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  employeeId     String   @map("employee_id")
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("ZAR")
  reference      String
  bankName       String?  @map("bank_name")
  accountNumber  String?  @map("account_number")
  branchCode     String?  @map("branch_code")
  status         String   @default("PENDING") // PENDING, SUBMITTED, PAID, FAILED, REVERSED
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  batch          PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([employeeId])
  @@map("payments")
}

/// PR-PAYRUN-GOV-3A — register (employee results) vs payment export (batch) reconciliation snapshot.
model PayrunFinancialControl {
  id                    String                       @id @default(uuid())
  payrunId              String                       @unique @map("payrun_id")
  paymentBatchId        String?                      @map("payment_batch_id")
  employeeCountRegister Int                          @map("employee_count_register")
  employeeCountExport   Int                          @map("employee_count_export")
  totalNetRegister      Decimal                      @map("total_net_register") @db.Decimal(18, 2)
  totalNetExport        Decimal                      @map("total_net_export") @db.Decimal(18, 2)
  varianceAmount        Decimal                      @map("variance_amount") @db.Decimal(18, 4)
  varianceEmployeeCount Int                        @map("variance_employee_count")
  status                PayrunFinancialControlStatus
  thresholdPolicy       String                       @default("DEFAULT_ZAR_0_05") @map("threshold_policy")
  reviewRequired        Boolean                      @default(false) @map("review_required")
  reviewedByUserId      String?                      @map("reviewed_by_user_id")
  reviewedAt            DateTime?                    @map("reviewed_at")
  softWarningsJson      Json?                        @map("soft_warnings_json")
  blockedReasonsJson    Json?                        @map("blocked_reasons_json")
  reconciledAt          DateTime?                    @map("reconciled_at")
  reconciledByUserId    String?                      @map("reconciled_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrun       PayRun         @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  paymentBatch PaymentBatch? @relation(fields: [paymentBatchId], references: [id], onDelete: SetNull)

  @@index([paymentBatchId])
  @@map("payrun_financial_controls")
}

/// PR-PAYRUN-GOV-3B — payment export vs bank confirmation (batch-scoped; payrun_id denormalized).
model PayrunBankReconciliation {
  id                           String                         @id @default(uuid())
  organizationId             String                         @map("organization_id")
  payrunId                     String                         @map("payrun_id")
  paymentBatchId               String                         @unique @map("payment_batch_id")
  bankFileReference            String                         @map("bank_file_reference")
  bankFileHash                 String?                        @map("bank_file_hash")
  exportTotal                  Decimal                        @map("export_total") @db.Decimal(18, 2)
  bankConfirmedTotal           Decimal                        @map("bank_confirmed_total") @db.Decimal(18, 2)
  exportEmployeeCount          Int                            @map("export_employee_count")
  bankConfirmedEmployeeCount   Int                            @map("bank_confirmed_employee_count")
  rejectedCount                Int                            @default(0) @map("rejected_count")
  partialCount                 Int                            @default(0) @map("partial_count")
  varianceAmount               Decimal                        @map("variance_amount") @db.Decimal(18, 4)
  status                       PayrunBankReconciliationStatus
  sourceType                   PayrunBankConfirmationSourceType @map("source_type")
  confirmedAt                  DateTime?                      @map("confirmed_at")
  reviewRequired               Boolean                        @default(false) @map("review_required")
  reviewedByUserId             String?                        @map("reviewed_by_user_id")
  reviewedAt                   DateTime?                      @map("reviewed_at")
  softWarningsJson             Json?                          @map("soft_warnings_json")
  blockedReasonsJson           Json?                          @map("blocked_reasons_json")
  importedByUserId             String?                        @map("imported_by_user_id")
  importedAt                   DateTime                       @default(now()) @map("imported_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrun        PayRun         @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  paymentBatch  PaymentBatch   @relation(fields: [paymentBatchId], references: [id], onDelete: Cascade)

  @@index([payrunId])
  @@index([organizationId, bankFileHash])
  @@map("payrun_bank_reconciliations")
}

/// PR-PAYRUN-GOV-3C — payroll register vs GL posting (per payrun).
model PayrunGLReconciliation {
  id                       String                       @id @default(uuid())
  legalEntityId            String                       @map("legal_entity_id")
  payrunId                 String                       @unique @map("payrun_id")
  glBatchReference         String                       @map("gl_batch_reference")
  glPostingHash            String?                      @map("gl_posting_hash")
  registerGross            Decimal                      @map("register_gross") @db.Decimal(18, 2)
  registerNet              Decimal                      @map("register_net") @db.Decimal(18, 2)
  registerPaye             Decimal                      @map("register_paye") @db.Decimal(18, 2)
  registerDeductions       Decimal                      @map("register_deductions") @db.Decimal(18, 2)
  glGross                  Decimal                      @map("gl_gross") @db.Decimal(18, 2)
  glNet                    Decimal                      @map("gl_net") @db.Decimal(18, 2)
  glPaye                   Decimal                      @map("gl_paye") @db.Decimal(18, 2)
  glDeductions             Decimal                      @map("gl_deductions") @db.Decimal(18, 2)
  varianceAmount           Decimal                      @map("variance_amount") @db.Decimal(18, 4)
  varianceDimensionsJson   Json?                        @map("variance_dimensions_json")
  status                   PayrunGLReconciliationStatus
  reviewRequired           Boolean                      @default(false) @map("review_required")
  reviewedByUserId         String?                      @map("reviewed_by_user_id")
  reviewedAt               DateTime?                    @map("reviewed_at")
  sourceType               PayrunGLConfirmationSourceType @map("source_type")
  softWarningsJson         Json?                        @map("soft_warnings_json")
  blockedReasonsJson       Json?                        @map("blocked_reasons_json")
  importedByUserId         String?                      @map("imported_by_user_id")
  importedAt               DateTime                     @default(now()) @map("imported_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrun PayRun @relation(fields: [payrunId], references: [id], onDelete: Cascade)

  @@index([legalEntityId, glPostingHash])
  @@map("payrun_gl_reconciliations")
}

// ============================================================================
// LEAVE MANAGEMENT
// ============================================================================

enum LeaveTypeCode {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  FAMILY_RESPONSIBILITY
  STUDY
  UNPAID
  COMPASSIONATE
  CUSTOM
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  TAKEN
}

enum LeaveAccrualType {
  MONTHLY
  ANNUAL
  OPENING_BALANCE
  ADJUSTMENT
  CARRY_OVER
  FORFEIT
  ENCASHMENT
  TERMINATION_PAYOUT
}

model LeaveType {
  id                    String        @id @default(uuid())
  organizationId        String?       @map("organization_id") // null = system default
  country               Country
  code                  LeaveTypeCode
  name                  String
  description           String?

  // Entitlement Configuration
  defaultEntitlement    Decimal       @default(0) @map("default_entitlement") @db.Decimal(5, 2)
  entitlementUnit       String        @default("DAYS") @map("entitlement_unit") // DAYS, HOURS

  // Accrual Configuration
  accrualRate           Decimal       @default(0) @map("accrual_rate") @db.Decimal(5, 2)
  accrualFrequency      String        @default("MONTHLY") @map("accrual_frequency") // MONTHLY, ANNUAL, NONE
  qualifyingMonths      Int           @default(0) @map("qualifying_months") // Months before accrual starts

  // Cycle Configuration
  cycleType             String        @default("CALENDAR_YEAR") @map("cycle_type") // CALENDAR_YEAR, ANNIVERSARY, CUSTOM
  cycleLengthYears      Int           @default(1) @map("cycle_length_years") // 1 for annual, 3 for ZA sick

  // Carry Over Rules
  allowCarryOver        Boolean       @default(true) @map("allow_carry_over")
  maxCarryOverDays      Decimal?      @map("max_carry_over_days") @db.Decimal(5, 2)
  carryOverExpiryMonths Int?          @map("carry_over_expiry_months")

  // Payment Rules
  isPaid                Boolean       @default(true) @map("is_paid")
  paidPercentage        Decimal       @default(100) @map("paid_percentage") @db.Decimal(5, 2)
  payoutOnTermination   Boolean       @default(false) @map("payout_on_termination")

  // Validation Rules
  requiresApproval      Boolean       @default(true) @map("requires_approval")
  requiresCertificate   Boolean       @default(false) @map("requires_certificate")
  certificateAfterDays  Int?          @map("certificate_after_days")
  minNoticeDays         Int           @default(0) @map("min_notice_days")
  maxConsecutiveDays    Int?          @map("max_consecutive_days")
  minRequestDays        Decimal       @default(0.5) @map("min_request_days") @db.Decimal(3, 1)

  // Negative Balance Rules
  allowNegativeBalance  Boolean       @default(false) @map("allow_negative_balance")
  maxNegativeDays       Decimal?      @map("max_negative_days") @db.Decimal(5, 2)

  // Status
  isActive              Boolean       @default(true) @map("is_active")
  isStatutory           Boolean       @default(false) @map("is_statutory")
  sortOrder             Int           @default(100) @map("sort_order")

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  balances              LeaveBalance[]
  requests              LeaveRequest[]
  accruals              LeaveAccrual[]
  policies              LeavePolicy[]

  @@unique([organizationId, country, code])
  @@index([country, isActive])
  @@map("leave_types")
}

model LeaveBalance {
  id                  String    @id @default(uuid())
  employeeId          String    @map("employee_id")
  leaveTypeId         String    @map("leave_type_id")

  // Cycle Period
  cycleStartDate      DateTime  @map("cycle_start_date") @db.Date
  cycleEndDate        DateTime  @map("cycle_end_date") @db.Date

  // Balance Components
  openingBalance      Decimal   @default(0) @map("opening_balance") @db.Decimal(7, 2)
  accrued             Decimal   @default(0) @db.Decimal(7, 2)
  taken               Decimal   @default(0) @db.Decimal(7, 2)
  pending             Decimal   @default(0) @db.Decimal(7, 2) // Approved but not yet taken
  adjustment          Decimal   @default(0) @db.Decimal(7, 2)
  forfeited           Decimal   @default(0) @db.Decimal(7, 2)
  encashed            Decimal   @default(0) @db.Decimal(7, 2)

  // Calculated Balance (denormalized for performance)
  currentBalance      Decimal   @default(0) @map("current_balance") @db.Decimal(7, 2)
  availableBalance    Decimal   @default(0) @map("available_balance") @db.Decimal(7, 2)

  // Carry Over Tracking
  carryOverBalance    Decimal   @default(0) @map("carry_over_balance") @db.Decimal(7, 2)
  carryOverExpiresAt  DateTime? @map("carry_over_expires_at") @db.Date

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  employee            Employee  @relation(fields: [employeeId], references: [id])
  leaveType           LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, cycleStartDate])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                    String             @id @default(uuid())
  employeeId            String             @map("employee_id")
  leaveTypeId           String             @map("leave_type_id")

  // Request Details
  startDate             DateTime           @map("start_date") @db.Date
  endDate               DateTime           @map("end_date") @db.Date
  startHalf             String?            @map("start_half") // FULL, AM, PM
  endHalf               String?            @map("end_half")
  totalDays             Decimal            @map("total_days") @db.Decimal(5, 2)
  totalHours            Decimal?           @map("total_hours") @db.Decimal(7, 2)

  // Reason and Notes
  reason                String?
  notes                 String?

  // Supporting Documents
  certificateRequired   Boolean            @default(false) @map("certificate_required")
  certificateUploaded   Boolean            @default(false) @map("certificate_uploaded")
  certificateUrl        String?            @map("certificate_url")

  // Status
  status                LeaveRequestStatus @default(PENDING)

  // Workflow
  submittedAt           DateTime           @default(now()) @map("submitted_at")
  submittedBy           String             @map("submitted_by")
  reviewedAt            DateTime?          @map("reviewed_at")
  reviewedBy            String?            @map("reviewed_by")
  reviewComment         String?            @map("review_comment")
  cancelledAt           DateTime?          @map("cancelled_at")
  cancelledBy           String?            @map("cancelled_by")
  cancelReason          String?            @map("cancel_reason")

  // Payroll Impact
  affectsPayroll        Boolean            @default(false) @map("affects_payroll")
  payrunId              String?            @map("payrun_id")
  deductionAmount       Decimal?           @map("deduction_amount") @db.Decimal(15, 2)
  paidAmount            Decimal?           @map("paid_amount") @db.Decimal(15, 2)

  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  // Relations
  employee              Employee           @relation(fields: [employeeId], references: [id])
  leaveType             LeaveType          @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

model LeaveAccrual {
  id              String          @id @default(uuid())
  employeeId      String          @map("employee_id")
  leaveTypeId     String          @map("leave_type_id")

  // Accrual Details
  accrualDate     DateTime        @map("accrual_date") @db.Date
  accrualType     LeaveAccrualType @map("accrual_type")
  amount          Decimal         @db.Decimal(7, 2)
  balanceBefore   Decimal         @default(0) @map("balance_before") @db.Decimal(7, 2)
  balanceAfter    Decimal         @default(0) @map("balance_after") @db.Decimal(7, 2)

  // Reference
  payPeriodId     String?         @map("pay_period_id")
  leaveRequestId  String?         @map("leave_request_id")
  reference       String?
  notes           String?

  createdAt       DateTime        @default(now()) @map("created_at")
  createdBy       String?         @map("created_by")

  // Relations
  employee        Employee        @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType       @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, accrualDate])
  @@index([leaveTypeId])
  @@index([accrualType])
  @@map("leave_accruals")
}

model LeavePolicy {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  payGroupId            String?   @map("pay_group_id")
  leaveTypeId           String    @map("leave_type_id")
  country               Country

  // Entitlement Override
  entitlementDays       Decimal?  @map("entitlement_days") @db.Decimal(5, 2)
  accrualRate           Decimal?  @map("accrual_rate") @db.Decimal(5, 2)

  // Service-based Tiers (JSON array)
  // Example: [{ "minYears": 5, "entitlement": 20 }, { "minYears": 10, "entitlement": 25 }]
  serviceTiers          Json?     @map("service_tiers")

  // Employment Type Rules (JSON object)
  // Example: { "PERMANENT": 15, "CONTRACT": 10, "CASUAL": 0 }
  employmentTypeRules   Json?     @map("employment_type_rules")

  // Additional Rules
  additionalRules       Json?     @map("additional_rules")

  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  isActive              Boolean   @default(true) @map("is_active")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  leaveType             LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([organizationId, effectiveFrom])
  @@index([country, isActive])
  @@map("leave_policies")
}

model PublicHoliday {
  id            String    @id @default(uuid())
  country       Country
  year          Int
  date          DateTime  @db.Date
  name          String
  localName     String?   @map("local_name")
  observedDate  DateTime? @map("observed_date") @db.Date // When falls on weekend
  isNational    Boolean   @default(true) @map("is_national")
  region        String?   // For regional holidays

  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([country, year, date])
  @@index([country, year])
  @@map("public_holidays")
}

// ============================================================================
// DOCUMENT MANAGEMENT
// ============================================================================

enum DocumentCategory {
  IDENTITY              // ID documents, passports
  EMPLOYMENT            // Contracts, offer letters, termination letters
  QUALIFICATION         // Degrees, certificates, diplomas
  COMPLIANCE            // Policy acknowledgments, signed forms
  TAX                   // Tax certificates, IRP5s
  BANKING               // Bank confirmation letters
  MEDICAL               // Medical certificates, fitness to work
  IMMIGRATION           // Work permits, visas
  LICENSE               // Professional licenses, driving licenses
  PERFORMANCE           // Performance reviews, disciplinary records
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD        // Placeholder, awaiting upload
  UPLOADED              // File uploaded, pending verification
  VERIFIED              // Document verified by HR/admin
  REJECTED              // Document rejected, needs re-upload
  EXPIRED               // Document has expired
  ARCHIVED              // No longer active but retained
}

model DocumentType {
  id                    String            @id @default(uuid())
  organizationId        String?           @map("organization_id")
  code                  String
  name                  String
  description           String?
  category              DocumentCategory

  // Requirements
  isRequired            Boolean           @default(false) @map("is_required")
  requiresExpiry        Boolean           @default(false) @map("requires_expiry")
  requiresVerification  Boolean           @default(true) @map("requires_verification")

  // Expiry Configuration
  defaultExpiryMonths   Int?              @map("default_expiry_months")
  expiryWarningDays     Int               @default(30) @map("expiry_warning_days")
  expiryReminderDays    Int[]             @default([30, 14, 7]) @map("expiry_reminder_days")

  // File Constraints
  allowedMimeTypes      String[]          @default(["application/pdf", "image/jpeg", "image/png"]) @map("allowed_mime_types")
  maxFileSizeMb         Int               @default(10) @map("max_file_size_mb")

  // Retention
  retentionYears        Int?              @map("retention_years")

  // Status
  isActive              Boolean           @default(true) @map("is_active")
  sortOrder             Int               @default(100) @map("sort_order")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  documents             Document[]

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("document_types")
}

model Document {
  id                    String            @id @default(uuid())
  employeeId            String            @map("employee_id")
  documentTypeId        String            @map("document_type_id")
  organizationId        String            @map("organization_id")

  // File Information
  fileName              String            @map("file_name")
  originalFileName      String            @map("original_file_name")
  mimeType              String            @map("mime_type")
  fileSizeBytes         Int               @map("file_size_bytes")
  storagePath           String            @map("storage_path")
  storageProvider       String            @default("local") @map("storage_provider") // local, s3, azure

  // Document Details
  title                 String?
  description           String?
  documentNumber        String?           @map("document_number") // ID number, license number, etc.
  issueDate             DateTime?         @map("issue_date") @db.Date
  expiryDate            DateTime?         @map("expiry_date") @db.Date
  issuingAuthority      String?           @map("issuing_authority")
  country               Country?

  // Status & Workflow
  status                DocumentStatus    @default(UPLOADED)
  version               Int               @default(1)
  isLatestVersion       Boolean           @default(true) @map("is_latest_version")
  previousVersionId     String?           @map("previous_version_id")

  // Verification
  verifiedAt            DateTime?         @map("verified_at")
  verifiedBy            String?           @map("verified_by")
  verificationNotes     String?           @map("verification_notes")
  rejectionReason       String?           @map("rejection_reason")

  // Security
  checksumSha256        String?           @map("checksum_sha256")
  isEncrypted           Boolean           @default(false) @map("is_encrypted")
  encryptionKeyId       String?           @map("encryption_key_id")

  // Access Control
  isConfidential        Boolean           @default(false) @map("is_confidential")
  visibleToEmployee     Boolean           @default(true) @map("visible_to_employee")

  // Metadata
  metadata              Json              @default("{}")
  tags                  String[]          @default([])

  // Audit
  uploadedBy            String            @map("uploaded_by")
  uploadedAt            DateTime          @default(now()) @map("uploaded_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  // Relations
  employee              Employee          @relation(fields: [employeeId], references: [id])
  documentType          DocumentType      @relation(fields: [documentTypeId], references: [id])
  accessLogs            DocumentAccessLog[]
  expiryAlerts          DocumentExpiryAlert[]

  @@index([employeeId, status])
  @@index([documentTypeId])
  @@index([organizationId, status])
  @@index([expiryDate])
  @@map("documents")
}

model DocumentAccessLog {
  id              String    @id @default(uuid())
  documentId      String    @map("document_id")
  userId          String    @map("user_id")
  action          String    // VIEW, DOWNLOAD, PRINT, SHARE
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  accessedAt      DateTime  @default(now()) @map("accessed_at")

  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, accessedAt])
  @@index([userId, accessedAt])
  @@map("document_access_logs")
}

model DocumentExpiryAlert {
  id              String    @id @default(uuid())
  documentId      String    @map("document_id")
  alertDate       DateTime  @map("alert_date") @db.Date
  daysBeforeExpiry Int      @map("days_before_expiry")
  alertSent       Boolean   @default(false) @map("alert_sent")
  sentAt          DateTime? @map("sent_at")
  notificationId  String?   @map("notification_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, daysBeforeExpiry])
  @@index([alertDate, alertSent])
  @@map("document_expiry_alerts")
}

model DocumentRequest {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  documentTypeId  String    @map("document_type_id")
  organizationId  String    @map("organization_id")

  // Request Details
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  dueDate         DateTime? @map("due_date") @db.Date
  reason          String?
  priority        String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Status
  status          String    @default("PENDING") // PENDING, UPLOADED, OVERDUE, CANCELLED
  fulfilledAt     DateTime? @map("fulfilled_at")
  documentId      String?   @map("document_id")

  // Reminders
  remindersSent   Int       @default(0) @map("reminders_sent")
  lastReminderAt  DateTime? @map("last_reminder_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([organizationId, status])
  @@index([dueDate])
  @@map("document_requests")
}

// ============================================================================
// PAYROLL CYCLE: RECONCILIATION
// ============================================================================

model PayrollReconciliation {
  id                   String    @id @default(uuid())
  periodId             String    @map("period_id")
  comparisonPeriodId   String    @map("comparison_period_id")
  reconciliationType   String    @default("period_over_period") @map("reconciliation_type")
  totalVariance        Decimal   @default(0) @map("total_variance") @db.Decimal(18, 2)
  variancePercentage   Decimal   @default(0) @map("variance_percentage") @db.Decimal(10, 4)
  status               String    @default("pending") // pending, in_progress, completed, reviewed
  reconciledBy         String    @map("reconciled_by")
  reconciledAt         DateTime? @map("reconciled_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  period               PayPeriod @relation("ReconciliationPeriod", fields: [periodId], references: [id])
  comparisonPeriod     PayPeriod @relation("ReconciliationComparison", fields: [comparisonPeriodId], references: [id])
  reconciledByUser     User      @relation(fields: [reconciledBy], references: [id])
  items                PayrollReconciliationItem[]

  @@index([periodId])
  @@index([status])
  @@map("payroll_reconciliations")
}

model PayrollReconciliationItem {
  id                 String                @id @default(uuid())
  reconciliationId   String                @map("reconciliation_id")
  itemType           String                @map("item_type") // gross_pay, deductions, net_pay, paye, uif, employee_count
  currentValue       Decimal               @map("current_value") @db.Decimal(18, 2)
  comparisonValue    Decimal               @map("comparison_value") @db.Decimal(18, 2)
  varianceAmount     Decimal               @map("variance_amount") @db.Decimal(18, 2)
  variancePercentage Decimal               @map("variance_percentage") @db.Decimal(10, 4)
  explanation        String?
  isExplained        Boolean               @default(false) @map("is_explained")
  createdAt          DateTime              @default(now()) @map("created_at")

  reconciliation     PayrollReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@map("payroll_reconciliation_items")
}

// ============================================================================
// PAYROLL CYCLE: EXCEPTIONS
// ============================================================================

model PayrollException {
  id                String    @id @default(uuid())
  periodId          String    @map("period_id")
  payrunId          String    @map("payrun_id")
  employeeId        String    @map("employee_id")
  exceptionType     String    @map("exception_type") // variance_threshold, missing_data, duplicate, compliance
  exceptionCategory String    @map("exception_category") // earnings, deductions, attendance, tax
  severity          String    @default("medium") // low, medium, high, critical
  description       String
  expectedValue     Decimal?  @map("expected_value") @db.Decimal(18, 2)
  actualValue       Decimal?  @map("actual_value") @db.Decimal(18, 2)
  status            String    @default("pending") // pending, in_review, resolved, dismissed
  resolvedBy        String?   @map("resolved_by")
  resolvedAt        DateTime? @map("resolved_at")
  resolutionNotes   String?   @map("resolution_notes")
  dismissedBy       String?   @map("dismissed_by")
  dismissedAt       DateTime? @map("dismissed_at")
  dismissReason     String?   @map("dismiss_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  period            PayPeriod @relation(fields: [periodId], references: [id])
  payrun            PayRun    @relation(fields: [payrunId], references: [id])
  employee          Employee  @relation(fields: [employeeId], references: [id])

  @@index([periodId, status])
  @@index([payrunId])
  @@index([employeeId])
  @@index([severity])
  @@map("payroll_exceptions")
}

// ============================================================================
// PAYROLL CYCLE: FORECASTING
// ============================================================================

model PayrollForecast {
  id                     String    @id @default(uuid())
  legalEntityId          String    @map("legal_entity_id")
  forecastName           String    @map("forecast_name")
  forecastType           String    @map("forecast_type") // monthly, quarterly, annual
  forecastPeriodStart    DateTime  @map("forecast_period_start") @db.Date
  forecastPeriodEnd      DateTime  @map("forecast_period_end") @db.Date
  basePeriodId           String?   @map("base_period_id")
  forecastMethod         String    @map("forecast_method") // historical_average, trend_analysis, manual, budget_based
  assumptions            Json?
  totalForecastAmount    Decimal   @default(0) @map("total_forecast_amount") @db.Decimal(18, 2)
  totalActualAmount      Decimal?  @map("total_actual_amount") @db.Decimal(18, 2)
  status                 String    @default("draft") // draft, active, completed
  createdBy              String    @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  legalEntity            LegalEntity @relation(fields: [legalEntityId], references: [id])
  items                  PayrollForecastItem[]

  @@index([legalEntityId, status])
  @@map("payroll_forecasts")
}

model PayrollForecastItem {
  id                 String          @id @default(uuid())
  forecastId         String          @map("forecast_id")
  itemType           String          @map("item_type") // basic_salary, overtime, benefits, deductions, total_compensation
  forecastAmount     Decimal         @map("forecast_amount") @db.Decimal(18, 2)
  actualAmount       Decimal?        @map("actual_amount") @db.Decimal(18, 2)
  varianceAmount     Decimal?        @map("variance_amount") @db.Decimal(18, 2)
  variancePercentage Decimal?        @map("variance_percentage") @db.Decimal(10, 4)
  createdAt          DateTime        @default(now()) @map("created_at")

  forecast           PayrollForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId])
  @@map("payroll_forecast_items")
}

// ============================================================================
// PAYROLL CYCLE: CHECKLIST
// ============================================================================

model PayrollChecklistTemplate {
  id           String    @id @default(uuid())
  templateName String    @map("template_name")
  description  String?
  frequency    String    @default("monthly") // weekly, monthly, quarterly, annual
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items        PayrollChecklistTemplateItem[]
  checklists   PayrollChecklist[]

  @@map("payroll_checklist_templates")
}

model PayrollChecklistTemplateItem {
  id              String                   @id @default(uuid())
  templateId      String                   @map("template_id")
  taskName        String                   @map("task_name")
  taskDescription String?                  @map("task_description")
  taskCategory    String                   @map("task_category") // data_collection, validation, calculation, approval, distribution
  taskOrder       Int                      @map("task_order")
  dueOffsetDays   Int                      @default(0) @map("due_offset_days") // days relative to period end
  isRequired      Boolean                  @default(true) @map("is_required")
  createdAt       DateTime                 @default(now()) @map("created_at")

  template        PayrollChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, taskOrder])
  @@map("payroll_checklist_template_items")
}

model PayrollChecklist {
  id                   String                   @id @default(uuid())
  periodId             String                   @map("period_id")
  templateId           String?                  @map("template_id")
  checklistName        String                   @map("checklist_name")
  status               String                   @default("pending") // pending, in_progress, completed
  totalTasks           Int                      @default(0) @map("total_tasks")
  completedTasks       Int                      @default(0) @map("completed_tasks")
  completionPercentage Decimal                  @default(0) @map("completion_percentage") @db.Decimal(5, 2)
  createdBy            String                   @map("created_by")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  period               PayPeriod                @relation(fields: [periodId], references: [id])
  template             PayrollChecklistTemplate? @relation(fields: [templateId], references: [id])
  tasks                PayrollChecklistTask[]

  @@index([periodId])
  @@map("payroll_checklists")
}

model PayrollChecklistTask {
  id              String            @id @default(uuid())
  checklistId     String            @map("checklist_id")
  taskName        String            @map("task_name")
  taskDescription String?           @map("task_description")
  taskCategory    String            @map("task_category")
  taskOrder       Int               @map("task_order")
  dueDate         DateTime?         @map("due_date") @db.Date
  isRequired      Boolean           @default(true) @map("is_required")
  status          String            @default("pending") // pending, in_progress, completed, skipped
  assignedTo      String?           @map("assigned_to")
  completedBy     String?           @map("completed_by")
  completedAt     DateTime?         @map("completed_at")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")

  checklist       PayrollChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignedUser    User?             @relation("ChecklistTaskAssigned", fields: [assignedTo], references: [id])
  completedByUser User?             @relation("ChecklistTaskCompleted", fields: [completedBy], references: [id])

  @@index([checklistId, taskOrder])
  @@index([assignedTo, status])
  @@map("payroll_checklist_tasks")
}

// ============================================================================
// BENEFITS: PLANS, OPTIONS, RATES
// ============================================================================

model BenefitPlan {
  id               String    @id @default(uuid())
  name             String
  benefitType      String    @map("benefit_type") // medical_aid, pension_fund, provident_fund, retirement_annuity, group_life, disability_insurance, gap_cover, funeral_cover
  providerName     String?   @map("provider_name")
  providerCode     String?   @map("provider_code")
  description      String?
  isStatutory      Boolean   @default(false) @map("is_statutory")
  isActive         Boolean   @default(true) @map("is_active")
  allowsDependents Boolean   @default(false) @map("allows_dependents")
  requiresApproval Boolean   @default(true) @map("requires_approval")
